@using ChainPOS.Constants
@model ChainPOS.ViewModels.Admin.Subscriptions.TenantSubscriptionCreateViewModel
@{
    ViewData["Title"] = "Create Subscription";
    ViewData["ActiveMenu"] = "payments";
}

<div class="max-w-3xl" data-live-page="subscription">
    <div class="mb-5">
        <a asp-controller="Tenants" asp-action="Index" class="text-sm text-orange-600 font-semibold hover:text-orange-700">Back to tenants</a>
        <h1 class="text-2xl font-bold text-gray-900 mt-2">Create Tenant Subscription</h1>
        <p class="text-sm text-gray-500 mt-1">Assign a plan and optionally create a pending SaaS payment.</p>
    </div>

    <form method="post" class="bg-white rounded-2xl border border-orange-100 shadow-sm p-5 space-y-4">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-sm text-red-600"></div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <label asp-for="TenantId" class="block text-xs font-semibold text-gray-600 mb-1.5">Tenant</label>
                <select asp-for="TenantId" class="w-full px-3.5 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 bg-white">
                    <option value="">Select tenant</option>
                    @foreach (var tenant in Model.Tenants)
                    {
                        <option value="@tenant.Id">@tenant.Name</option>
                    }
                </select>
                <span asp-validation-for="TenantId" class="text-xs text-red-600"></span>
            </div>
            <div>
                <label asp-for="PlanId" class="block text-xs font-semibold text-gray-600 mb-1.5">Plan</label>
                <select asp-for="PlanId" class="w-full px-3.5 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 bg-white">
                    <option value="">Select plan</option>
                    @foreach (var plan in Model.Plans)
                    {
                        <option value="@plan.Id">@plan.Name - @plan.Price.ToString("#,##0.##") / @plan.BillingCycle</option>
                    }
                </select>
                <span asp-validation-for="PlanId" class="text-xs text-red-600"></span>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div>
                <label asp-for="StartDate" class="block text-xs font-semibold text-gray-600 mb-1.5"></label>
                <input asp-for="StartDate" type="date" class="w-full px-3.5 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 bg-white" />
            </div>
            <div>
                <label asp-for="EndDate" class="block text-xs font-semibold text-gray-600 mb-1.5"></label>
                <input asp-for="EndDate" type="date" class="w-full px-3.5 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 bg-white" />
            </div>
            <div>
                <label asp-for="Status" class="block text-xs font-semibold text-gray-600 mb-1.5"></label>
                <select asp-for="Status" class="w-full px-3.5 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 bg-white">
                    @foreach (var status in SubscriptionStatuses.All)
                    {
                        <option value="@status">@status</option>
                    }
                </select>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <label class="inline-flex items-center gap-2 text-sm text-gray-700">
                <input asp-for="AutoRenew" class="w-4 h-4 accent-orange-500" />
                <span>Auto renew</span>
            </label>
            <label class="inline-flex items-center gap-2 text-sm text-gray-700">
                <input asp-for="CreatePendingPayment" class="w-4 h-4 accent-orange-500" />
                <span>Create pending payment</span>
            </label>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <label asp-for="PaymentMethod" class="block text-xs font-semibold text-gray-600 mb-1.5"></label>
                <select asp-for="PaymentMethod" class="w-full px-3.5 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 bg-white">
                    <option value="@PaymentMethods.SePay">SePay</option>
                    <option value="@PaymentMethods.BankTransfer">BankTransfer</option>
                    <option value="@PaymentMethods.Card">Card</option>
                    <option value="@PaymentMethods.Momo">Momo</option>
                    <option value="@PaymentMethods.ZaloPay">ZaloPay</option>
                    <option value="@PaymentMethods.Other">Other</option>
                </select>
            </div>
            <div>
                <label asp-for="InvoiceUrl" class="block text-xs font-semibold text-gray-600 mb-1.5"></label>
                <input asp-for="InvoiceUrl" placeholder="https://..." class="w-full px-3.5 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 bg-white" />
                <span asp-validation-for="InvoiceUrl" class="text-xs text-red-600"></span>
            </div>
        </div>

        <div class="flex justify-end gap-2 pt-2">
            <a asp-controller="Tenants" asp-action="Index" class="px-4 py-2.5 rounded-xl border border-gray-200 text-sm font-semibold text-gray-600 hover:border-orange-200 hover:text-orange-600">Cancel</a>
            <button type="submit" class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-orange-500 to-amber-500 text-sm font-semibold text-white hover:from-orange-600 hover:to-amber-600">Create Subscription</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
