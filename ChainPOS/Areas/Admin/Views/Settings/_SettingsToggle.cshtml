@model (string Name, string Label, string Description, bool Value)

<div class="flex items-center justify-between py-3 border-b border-gray-50 last:border-b-0">
    <div>
        <p class="font-medium text-gray-800 text-sm">@Model.Label</p>
        <p class="text-xs text-gray-400">@Model.Description</p>
    </div>
    <label class="relative inline-flex items-center cursor-pointer">
        <input type="checkbox" name="@Model.Name" value="true" checked="@Model.Value" class="sr-only peer" />
        <input type="hidden" name="@Model.Name" value="false" />
        <span class="w-11 h-6 bg-gray-200 rounded-full peer peer-checked:bg-orange-500 after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:w-5 after:h-5 after:bg-white after:rounded-full after:shadow after:transition-all peer-checked:after:translate-x-5"></span>
    </label>
</div>
