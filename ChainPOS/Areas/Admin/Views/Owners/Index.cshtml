@using ChainPOS.Constants
@model ChainPOS.ViewModels.Admin.Owners.OwnerIndexViewModel
@{
    ViewData["Title"] = "Owners";
    ViewData["ActiveMenu"] = "owners";

    string StatusClass(string status) => status switch
    {
        UserStatuses.Active => "bg-green-50 text-green-700 border-green-100",
        UserStatuses.Locked => "bg-red-50 text-red-700 border-red-100",
        UserStatuses.Pending => "bg-amber-50 text-amber-700 border-amber-100",
        _ => "bg-gray-50 text-gray-600 border-gray-100"
    };
}

<div class="flex flex-col gap-5">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">Owner Management</h1>
            <p class="text-sm text-gray-500 mt-1">Create and control tenant owner accounts.</p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <a asp-action="Import" class="rounded-xl border border-orange-200 bg-orange-50 px-4 py-2.5 text-sm font-semibold text-orange-700 hover:bg-orange-100">Import</a>
            <a asp-action="Create" class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-orange-500 text-white text-sm font-semibold hover:bg-orange-600 shadow-sm">
                <span>+</span>
                <span>Create Owner</span>
            </a>
        </div>
    </div>

    <div class="bg-white rounded-2xl border border-orange-100 shadow-sm">
        <form asp-action="Index" method="get" class="grid grid-cols-1 md:grid-cols-[1fr_180px_auto] gap-3 p-5 border-b border-gray-50">
            <input asp-for="Search" placeholder="Search owner, email or tenant..." class="w-full rounded-xl border border-gray-200 bg-gray-50 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 focus:bg-white" />
            <select asp-for="Status" class="rounded-xl border border-gray-200 bg-gray-50 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 focus:bg-white">
                <option value="">All statuses</option>
                <option value="@UserStatuses.Active">Active</option>
                <option value="@UserStatuses.Locked">Locked</option>
                <option value="@UserStatuses.Pending">Pending</option>
                <option value="@UserStatuses.Inactive">Inactive</option>
            </select>
            <button type="submit" class="rounded-xl bg-orange-500 px-5 py-2.5 text-sm font-semibold text-white hover:bg-orange-600">Filter</button>
        </form>

        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-100">
                <thead class="bg-orange-50/60">
                    <tr class="text-left text-xs font-bold uppercase tracking-wider text-gray-500">
                        <th class="px-5 py-3">Owner</th>
                        <th class="px-5 py-3">Tenant</th>
                        <th class="px-5 py-3">Status</th>
                        <th class="px-5 py-3">Created</th>
                        <th class="px-5 py-3 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-50 bg-white">
                    @if (Model.Owners.Count == 0)
                    {
                        <tr>
                            <td colspan="5" class="px-5 py-10 text-center text-sm text-gray-400">No owners found.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var owner in Model.Owners)
                        {
                            <tr class="hover:bg-orange-50/40">
                                <td class="px-5 py-4">
                                    <div class="font-semibold text-gray-900">@owner.FullName</div>
                                    <div class="text-xs text-gray-500">@owner.Email</div>
                                    @if (!string.IsNullOrWhiteSpace(owner.PhoneNumber))
                                    {
                                        <div class="text-xs text-gray-400">@owner.PhoneNumber</div>
                                    }
                                </td>
                                <td class="px-5 py-4">
                                    <div class="font-medium text-gray-800">@(string.IsNullOrWhiteSpace(owner.TenantName) ? "No tenant" : owner.TenantName)</div>
                                    <div class="text-xs text-gray-400">@owner.TenantStatus</div>
                                </td>
                                <td class="px-5 py-4">
                                    <span class="inline-flex rounded-full border px-2.5 py-1 text-xs font-semibold @StatusClass(owner.Status)">@owner.Status</span>
                                </td>
                                <td class="px-5 py-4 text-sm text-gray-500">@owner.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                                <td class="px-5 py-4">
                                    <div class="flex items-center justify-end gap-2">
                                        <a asp-action="Details" asp-route-id="@owner.Id" class="rounded-lg border border-gray-200 px-3 py-1.5 text-xs font-semibold text-gray-600 hover:border-orange-200 hover:text-orange-600">Details</a>
                                        @if (owner.IsLocked)
                                        {
                                            <form id="unlock-@owner.Id" asp-action="Unlock" asp-route-id="@owner.Id" method="post" onsubmit="return openConfirmModal(this.id, 'Unlock owner', 'Allow this owner to sign in again?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="rounded-lg bg-green-50 px-3 py-1.5 text-xs font-semibold text-green-700 hover:bg-green-100">Unlock</button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form id="lock-@owner.Id" asp-action="Lock" asp-route-id="@owner.Id" method="post" onsubmit="return openConfirmModal(this.id, 'Lock owner', 'This owner will not be able to sign in.');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="rounded-lg bg-red-50 px-3 py-1.5 text-xs font-semibold text-red-700 hover:bg-red-100">Lock</button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="px-5 py-4 border-t border-gray-50 text-sm text-gray-500">
            Showing @Model.TotalOwners owner(s).
        </div>
    </div>
</div>
