@using ChainPOS.Constants
@model ChainPOS.ViewModels.Admin.Owners.OwnerDetailsViewModel
@{
    ViewData["Title"] = "Owner Details";
    ViewData["ActiveMenu"] = "owners";
}

<div class="space-y-5">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">@Model.FullName</h1>
            <p class="text-sm text-gray-500 mt-1">@Model.Email</p>
        </div>
        <div class="flex items-center gap-2">
            <a asp-action="Index" class="rounded-xl border border-gray-200 px-4 py-2.5 text-sm font-semibold text-gray-600 hover:border-orange-200 hover:text-orange-600">Back</a>
            @if (Model.IsLocked)
            {
                <form id="unlock-detail-@Model.Id" asp-action="Unlock" asp-route-id="@Model.Id" method="post" onsubmit="return openConfirmModal(this.id, 'Unlock owner', 'Allow this owner to sign in again?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="rounded-xl bg-green-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-green-700">Unlock</button>
                </form>
            }
            else
            {
                <form id="lock-detail-@Model.Id" asp-action="Lock" asp-route-id="@Model.Id" method="post" onsubmit="return openConfirmModal(this.id, 'Lock owner', 'This owner will not be able to sign in.');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="rounded-xl bg-red-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-red-700">Lock</button>
                </form>
            }
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-4 gap-5">
        <div class="rounded-2xl border border-orange-100 bg-white p-5 shadow-sm">
            <p class="text-sm text-gray-500">Stores</p>
            <p class="mt-2 text-3xl font-bold text-gray-900">@Model.StoreCount</p>
        </div>
        <div class="rounded-2xl border border-orange-100 bg-white p-5 shadow-sm">
            <p class="text-sm text-gray-500">Staff</p>
            <p class="mt-2 text-3xl font-bold text-gray-900">@Model.StaffCount</p>
        </div>
        <div class="rounded-2xl border border-orange-100 bg-white p-5 shadow-sm">
            <p class="text-sm text-gray-500">Products</p>
            <p class="mt-2 text-3xl font-bold text-gray-900">@Model.ProductCount</p>
        </div>
        <div class="rounded-2xl border border-orange-100 bg-white p-5 shadow-sm">
            <p class="text-sm text-gray-500">Revenue</p>
            <p class="mt-2 text-3xl font-bold text-gray-900">@Model.RevenueTotal.ToString("$#,##0.##")</p>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
        <section class="rounded-2xl border border-orange-100 bg-white p-5 shadow-sm">
            <h2 class="font-bold text-gray-900 mb-4">Owner Account</h2>
            <dl class="space-y-3 text-sm">
                <div class="flex justify-between gap-4"><dt class="text-gray-500">Status</dt><dd class="font-semibold text-gray-900">@Model.Status</dd></div>
                <div class="flex justify-between gap-4"><dt class="text-gray-500">Phone</dt><dd class="font-semibold text-gray-900">@(Model.PhoneNumber ?? "-")</dd></div>
                <div class="flex justify-between gap-4"><dt class="text-gray-500">Created</dt><dd class="font-semibold text-gray-900">@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd></div>
                <div class="flex justify-between gap-4"><dt class="text-gray-500">Last login</dt><dd class="font-semibold text-gray-900">@(Model.LastLoginAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "-")</dd></div>
            </dl>
        </section>

        <section class="rounded-2xl border border-orange-100 bg-white p-5 shadow-sm">
            <h2 class="font-bold text-gray-900 mb-4">Tenant</h2>
            <dl class="space-y-3 text-sm">
                <div class="flex justify-between gap-4"><dt class="text-gray-500">Name</dt><dd class="font-semibold text-gray-900">@Model.TenantName</dd></div>
                <div class="flex justify-between gap-4"><dt class="text-gray-500">Status</dt><dd class="font-semibold text-gray-900">@Model.TenantStatus</dd></div>
                <div class="flex justify-between gap-4"><dt class="text-gray-500">Phone</dt><dd class="font-semibold text-gray-900">@(Model.TenantPhone ?? "-")</dd></div>
                <div class="flex justify-between gap-4"><dt class="text-gray-500">Address</dt><dd class="font-semibold text-gray-900 text-right">@(Model.TenantAddress ?? "-")</dd></div>
            </dl>
            @if (Model.TenantId.HasValue)
            {
                <a asp-controller="Tenants" asp-action="Details" asp-route-id="@Model.TenantId" class="mt-4 inline-flex rounded-xl bg-orange-50 px-4 py-2 text-sm font-semibold text-orange-600 hover:bg-orange-100">View tenant</a>
            }
        </section>
    </div>
</div>
