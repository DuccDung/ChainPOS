@model ChainPOS.ViewModels.Admin.Owners.OwnerCreateViewModel
@{
    ViewData["Title"] = "Create Owner";
    ViewData["ActiveMenu"] = "owners";
}

<div class="max-w-5xl space-y-5">
    <div class="flex items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">Create Owner</h1>
            <p class="text-sm text-gray-500 mt-1">Create an owner account and its tenant in one transaction.</p>
        </div>
        <a asp-action="Index" class="rounded-xl border border-gray-200 px-4 py-2.5 text-sm font-semibold text-gray-600 hover:border-orange-200 hover:text-orange-600">Back</a>
    </div>

    <form asp-action="Create" method="post" class="bg-white rounded-2xl border border-orange-100 shadow-sm">
        @Html.AntiForgeryToken()
        <div class="p-5 border-b border-gray-50">
            <div asp-validation-summary="ModelOnly" class="mb-4 text-sm text-red-600"></div>
            <h2 class="font-bold text-gray-900">Owner Account</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
                <div>
                    <label asp-for="FullName" class="block text-sm font-semibold text-gray-700 mb-1.5"></label>
                    <input asp-for="FullName" class="w-full rounded-xl border border-gray-200 bg-gray-50 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 focus:bg-white" />
                    <span asp-validation-for="FullName" class="text-xs text-red-600"></span>
                </div>
                <div>
                    <label asp-for="Email" class="block text-sm font-semibold text-gray-700 mb-1.5"></label>
                    <input asp-for="Email" class="w-full rounded-xl border border-gray-200 bg-gray-50 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 focus:bg-white" />
                    <span asp-validation-for="Email" class="text-xs text-red-600"></span>
                </div>
                <div>
                    <label asp-for="PhoneNumber" class="block text-sm font-semibold text-gray-700 mb-1.5"></label>
                    <input asp-for="PhoneNumber" class="w-full rounded-xl border border-gray-200 bg-gray-50 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 focus:bg-white" />
                    <span asp-validation-for="PhoneNumber" class="text-xs text-red-600"></span>
                </div>
                <div>
                    <label asp-for="Password" class="block text-sm font-semibold text-gray-700 mb-1.5"></label>
                    <input asp-for="Password" class="w-full rounded-xl border border-gray-200 bg-gray-50 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 focus:bg-white" />
                    <span asp-validation-for="Password" class="text-xs text-red-600"></span>
                </div>
                <div>
                    <label asp-for="ConfirmPassword" class="block text-sm font-semibold text-gray-700 mb-1.5"></label>
                    <input asp-for="ConfirmPassword" class="w-full rounded-xl border border-gray-200 bg-gray-50 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 focus:bg-white" />
                    <span asp-validation-for="ConfirmPassword" class="text-xs text-red-600"></span>
                </div>
            </div>
        </div>

        <div class="p-5">
            <h2 class="font-bold text-gray-900">Tenant</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
                <div>
                    <label asp-for="TenantName" class="block text-sm font-semibold text-gray-700 mb-1.5"></label>
                    <input asp-for="TenantName" class="w-full rounded-xl border border-gray-200 bg-gray-50 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 focus:bg-white" />
                    <span asp-validation-for="TenantName" class="text-xs text-red-600"></span>
                </div>
                <div>
                    <label asp-for="TaxCode" class="block text-sm font-semibold text-gray-700 mb-1.5"></label>
                    <input asp-for="TaxCode" class="w-full rounded-xl border border-gray-200 bg-gray-50 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 focus:bg-white" />
                    <span asp-validation-for="TaxCode" class="text-xs text-red-600"></span>
                </div>
                <div>
                    <label asp-for="TenantPhone" class="block text-sm font-semibold text-gray-700 mb-1.5"></label>
                    <input asp-for="TenantPhone" class="w-full rounded-xl border border-gray-200 bg-gray-50 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 focus:bg-white" />
                    <span asp-validation-for="TenantPhone" class="text-xs text-red-600"></span>
                </div>
                <div class="md:col-span-2">
                    <label asp-for="TenantAddress" class="block text-sm font-semibold text-gray-700 mb-1.5"></label>
                    <input asp-for="TenantAddress" class="w-full rounded-xl border border-gray-200 bg-gray-50 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 focus:bg-white" />
                    <span asp-validation-for="TenantAddress" class="text-xs text-red-600"></span>
                </div>
            </div>
        </div>

        <div class="flex justify-end gap-3 rounded-b-2xl bg-gray-50 px-5 py-4">
            <a asp-action="Index" class="rounded-xl border border-gray-200 px-4 py-2.5 text-sm font-semibold text-gray-600">Cancel</a>
            <button type="submit" class="rounded-xl bg-orange-500 px-5 py-2.5 text-sm font-semibold text-white hover:bg-orange-600">Create Owner</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
