@using ChainPOS.Constants
@model ChainPOS.ViewModels.Admin.SubscriptionPlans.SubscriptionPlanFormViewModel

<form method="post" class="bg-white rounded-2xl border border-orange-100 shadow-sm p-5 space-y-4">
    @Html.AntiForgeryToken()
    <input asp-for="Id" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-sm text-red-600"></div>

    <div>
        <label asp-for="Name" class="block text-xs font-semibold text-gray-600 mb-1.5"></label>
        <input asp-for="Name" class="w-full px-3.5 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 bg-white" />
        <span asp-validation-for="Name" class="text-xs text-red-600"></span>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
            <label asp-for="Price" class="block text-xs font-semibold text-gray-600 mb-1.5"></label>
            <input asp-for="Price" type="number" step="0.01" min="0" class="w-full px-3.5 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 bg-white" />
            <span asp-validation-for="Price" class="text-xs text-red-600"></span>
        </div>
        <div>
            <label asp-for="BillingCycle" class="block text-xs font-semibold text-gray-600 mb-1.5"></label>
            <select asp-for="BillingCycle" class="w-full px-3.5 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 bg-white">
                @foreach (var cycle in BillingCycles.All)
                {
                    <option value="@cycle">@cycle</option>
                }
            </select>
            <span asp-validation-for="BillingCycle" class="text-xs text-red-600"></span>
        </div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div>
            <label asp-for="MaxStores" class="block text-xs font-semibold text-gray-600 mb-1.5"></label>
            <input asp-for="MaxStores" type="number" min="0" placeholder="Unlimited" class="w-full px-3.5 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 bg-white" />
            <span asp-validation-for="MaxStores" class="text-xs text-red-600"></span>
        </div>
        <div>
            <label asp-for="MaxStaff" class="block text-xs font-semibold text-gray-600 mb-1.5"></label>
            <input asp-for="MaxStaff" type="number" min="0" placeholder="Unlimited" class="w-full px-3.5 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 bg-white" />
            <span asp-validation-for="MaxStaff" class="text-xs text-red-600"></span>
        </div>
        <div>
            <label asp-for="MaxProducts" class="block text-xs font-semibold text-gray-600 mb-1.5"></label>
            <input asp-for="MaxProducts" type="number" min="0" placeholder="Unlimited" class="w-full px-3.5 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 bg-white" />
            <span asp-validation-for="MaxProducts" class="text-xs text-red-600"></span>
        </div>
    </div>
    <label class="inline-flex items-center gap-2 text-sm text-gray-700">
        <input asp-for="IsActive" class="w-4 h-4 accent-orange-500" />
        <span>Active</span>
    </label>
    <div class="flex justify-end gap-2 pt-2">
        <a asp-action="Index" class="px-4 py-2.5 rounded-xl border border-gray-200 text-sm font-semibold text-gray-600 hover:border-orange-200 hover:text-orange-600">Cancel</a>
        <button type="submit" class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-orange-500 to-amber-500 text-sm font-semibold text-white hover:from-orange-600 hover:to-amber-600">Save Plan</button>
    </div>
</form>
