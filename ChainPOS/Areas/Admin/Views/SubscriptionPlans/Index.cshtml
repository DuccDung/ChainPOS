@using ChainPOS.Constants
@model ChainPOS.ViewModels.Admin.SubscriptionPlans.SubscriptionPlanIndexViewModel
@{
    ViewData["Title"] = "Subscription Plans";
    ViewData["ActiveMenu"] = "plans";
    string Money(decimal value) => value.ToString("#,##0.##");
    string Limit(int? value) => value.HasValue ? value.Value.ToString("#,##0") : "Unlimited";
}

<div class="flex flex-col gap-5" data-live-page="plans">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 text-sm text-gray-400 mb-0.5">
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="hover:text-orange-500">Dashboard</a>
                <span>/</span><span class="text-orange-500 font-medium">Subscription Plans</span>
            </div>
            <h1 class="text-2xl font-bold text-gray-900">Subscription Plans</h1>
            <p class="text-sm text-gray-500 mt-1">Manage SaaS packages and tenant limits.</p>
        </div>
        <a asp-action="Create" class="inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-gradient-to-r from-orange-500 to-amber-500 text-white text-sm font-semibold rounded-xl hover:from-orange-600 hover:to-amber-600 shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
            Add Plan
        </a>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white rounded-2xl p-4 border border-orange-100 shadow-sm"><p class="text-2xl font-bold text-gray-900">@Model.TotalPlans</p><p class="text-xs text-gray-500">Total plans</p></div>
        <div class="bg-white rounded-2xl p-4 border border-orange-100 shadow-sm"><p class="text-2xl font-bold text-green-600">@Model.ActivePlans</p><p class="text-xs text-gray-500">Active</p></div>
        <div class="bg-white rounded-2xl p-4 border border-orange-100 shadow-sm"><p class="text-2xl font-bold text-amber-600">@Model.InactivePlans</p><p class="text-xs text-gray-500">Inactive</p></div>
        <div class="bg-white rounded-2xl p-4 border border-orange-100 shadow-sm"><p class="text-2xl font-bold text-gray-900">@Model.TenantSubscriptions</p><p class="text-xs text-gray-500">Active tenants</p></div>
    </div>

    <div class="bg-white rounded-2xl border border-orange-100 shadow-sm overflow-hidden">
        <div class="flex flex-col md:flex-row md:items-center justify-between px-5 py-4 gap-3 border-b border-gray-50">
            <div>
                <h3 class="font-bold text-gray-900">All Plans</h3>
                <p class="text-xs text-gray-400 mt-0.5">Showing @Model.Plans.Count record(s)</p>
            </div>
            <form asp-action="Index" method="get" class="flex items-center gap-2 flex-wrap">
                <input name="search" value="@Model.Search" placeholder="Search plans..." class="px-3 py-2 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 bg-gray-50 w-52" />
                <select name="status" class="px-3 py-2 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 bg-gray-50 text-gray-600">
                    <option value="">All Statuses</option>
                    <option value="Active" selected="@(Model.Status == "Active")">Active</option>
                    <option value="Inactive" selected="@(Model.Status == "Inactive")">Inactive</option>
                </select>
                <button type="submit" class="px-4 py-2 bg-orange-500 text-white text-sm font-semibold rounded-xl hover:bg-orange-600">Filter</button>
            </form>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="bg-amber-50 text-gray-500 text-xs font-semibold uppercase tracking-wider">
                        <th class="px-5 py-3 text-left">Plan</th>
                        <th class="px-5 py-3 text-right">Price</th>
                        <th class="px-5 py-3 text-left">Cycle</th>
                        <th class="px-5 py-3 text-center">Stores</th>
                        <th class="px-5 py-3 text-center">Staff</th>
                        <th class="px-5 py-3 text-center">Products</th>
                        <th class="px-5 py-3 text-center">Tenants</th>
                        <th class="px-5 py-3 text-left">Status</th>
                        <th class="px-5 py-3 text-left">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-50">
                    @if (Model.Plans.Count == 0)
                    {
                        <tr><td colspan="9" class="px-5 py-10 text-center text-sm text-gray-400">No plans found.</td></tr>
                    }
                    else
                    {
                        foreach (var plan in Model.Plans)
                        {
                            <tr class="hover:bg-orange-50/30">
                                <td class="px-5 py-3.5"><p class="font-semibold text-gray-800">@plan.Name</p><p class="text-xs text-gray-400">@plan.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</p></td>
                                <td class="px-5 py-3.5 text-right font-bold text-gray-900">@Money(plan.Price)</td>
                                <td class="px-5 py-3.5 text-gray-600">@plan.BillingCycle</td>
                                <td class="px-5 py-3.5 text-center">@Limit(plan.MaxStores)</td>
                                <td class="px-5 py-3.5 text-center">@Limit(plan.MaxStaff)</td>
                                <td class="px-5 py-3.5 text-center">@Limit(plan.MaxProducts)</td>
                                <td class="px-5 py-3.5 text-center font-semibold text-gray-900">@plan.ActiveTenantCount</td>
                                <td class="px-5 py-3.5"><span class="inline-flex rounded-full border px-2.5 py-0.5 text-xs font-semibold @(plan.IsActive ? "bg-green-50 text-green-700 border-green-100" : "bg-amber-50 text-amber-700 border-amber-100")">@(plan.IsActive ? "Active" : "Inactive")</span></td>
                                <td class="px-5 py-3.5">
                                    <div class="flex items-center gap-1">
                                        <a asp-action="Edit" asp-route-id="@plan.Id" class="px-3 py-1.5 rounded-lg bg-amber-50 text-amber-700 text-xs font-semibold hover:bg-amber-100">Edit</a>
                                        @if (plan.IsActive)
                                        {
                                            <form id="deactivate-plan-@plan.Id" asp-action="Deactivate" asp-route-id="@plan.Id" method="post" onsubmit="return openConfirmModal(this.id, 'Deactivate plan', 'Tenants cannot be newly assigned to this plan.');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="px-3 py-1.5 rounded-lg bg-gray-50 text-gray-600 text-xs font-semibold hover:bg-gray-100">Deactivate</button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-action="Activate" asp-route-id="@plan.Id" method="post">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="px-3 py-1.5 rounded-lg bg-green-50 text-green-700 text-xs font-semibold hover:bg-green-100">Activate</button>
                                            </form>
                                        }
                                        <form id="delete-plan-@plan.Id" asp-action="Delete" asp-route-id="@plan.Id" method="post" onsubmit="return openConfirmModal(this.id, 'Delete plan', 'Plan can be deleted only if no tenant has used it.');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="px-3 py-1.5 rounded-lg bg-red-50 text-red-600 text-xs font-semibold hover:bg-red-100">Delete</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
