@model ChainPOS.ViewModels.Owner.Staff.StaffCreateViewModel
@{
    ViewData["Title"] = "Add Staff";
    ViewData["ActiveMenu"] = "staff";
}

<div class="max-w-5xl space-y-5">
    <div class="flex items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 text-sm text-gray-400 mb-0.5">
                <a asp-action="Index" class="hover:text-orange-500">Staff</a>
                <span>/</span><span class="text-orange-500 font-medium">Add Staff</span>
            </div>
            <h1 class="text-2xl font-bold text-gray-900">Add New Staff</h1>
        </div>
        <a asp-action="Index" class="rounded-xl border border-gray-200 px-4 py-2.5 text-sm font-semibold text-gray-600 hover:border-orange-200 hover:text-orange-600">Back</a>
    </div>

    <form asp-action="Create" method="post" class="bg-white rounded-2xl border border-orange-100 shadow-sm">
        @Html.AntiForgeryToken()
        <div class="p-5 space-y-4">
            <div asp-validation-summary="ModelOnly" class="text-sm text-red-600"></div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label asp-for="FullName" class="block text-xs font-semibold text-gray-600 mb-1.5"></label>
                    <input asp-for="FullName" placeholder="John Smith" class="w-full px-3.5 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 bg-white" />
                    <span asp-validation-for="FullName" class="text-xs text-red-600"></span>
                </div>
                <div>
                    <label asp-for="Email" class="block text-xs font-semibold text-gray-600 mb-1.5"></label>
                    <input asp-for="Email" placeholder="staff@company.com" class="w-full px-3.5 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 bg-white" />
                    <span asp-validation-for="Email" class="text-xs text-red-600"></span>
                </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div>
                    <label asp-for="PhoneNumber" class="block text-xs font-semibold text-gray-600 mb-1.5"></label>
                    <input asp-for="PhoneNumber" placeholder="0900000000" class="w-full px-3.5 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 bg-white" />
                    <span asp-validation-for="PhoneNumber" class="text-xs text-red-600"></span>
                </div>
                <div>
                    <label asp-for="Password" class="block text-xs font-semibold text-gray-600 mb-1.5"></label>
                    <input asp-for="Password" class="w-full px-3.5 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 bg-white" />
                    <span asp-validation-for="Password" class="text-xs text-red-600"></span>
                </div>
                <div>
                    <label asp-for="ConfirmPassword" class="block text-xs font-semibold text-gray-600 mb-1.5"></label>
                    <input asp-for="ConfirmPassword" class="w-full px-3.5 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 bg-white" />
                    <span asp-validation-for="ConfirmPassword" class="text-xs text-red-600"></span>
                </div>
            </div>

            <div>
                <div class="flex items-center justify-between mb-3">
                    <label class="block text-xs font-semibold text-gray-600">Store Access</label>
                    <span class="text-xs text-gray-400">Staff can only work in selected stores</span>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                    @if (Model.Stores.Count == 0)
                    {
                        <div class="md:col-span-2 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-700">Create a store before assigning staff access.</div>
                    }
                    else
                    {
                        foreach (var store in Model.Stores)
                        {
                            <label class="flex items-center gap-3 rounded-xl border border-gray-200 bg-gray-50 px-4 py-3 text-sm hover:border-orange-200 hover:bg-orange-50">
                                <input type="checkbox" name="StoreIds" value="@store.StoreId" checked="@Model.StoreIds.Contains(store.StoreId)" class="w-4 h-4 accent-orange-500" />
                                <span>
                                    <span class="block font-semibold text-gray-800">@store.StoreName</span>
                                    <span class="block text-xs text-gray-400">@store.StoreCode</span>
                                </span>
                            </label>
                        }
                    }
                </div>
            </div>
        </div>
        <div class="flex gap-3 rounded-b-2xl bg-gray-50 px-5 py-4">
            <a asp-action="Index" class="flex-1 py-2.5 border border-gray-200 text-gray-600 text-sm font-semibold rounded-xl hover:bg-gray-50 text-center">Cancel</a>
            <button type="submit" class="flex-1 py-2.5 bg-gradient-to-r from-orange-500 to-amber-500 text-white text-sm font-semibold rounded-xl hover:from-orange-600 hover:to-amber-600">Add Staff</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
