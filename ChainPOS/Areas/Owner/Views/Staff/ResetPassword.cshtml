@model ChainPOS.ViewModels.Owner.Staff.StaffResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Staff Password";
    ViewData["ActiveMenu"] = "staff";
}

<div class="max-w-3xl space-y-5">
    <div class="flex items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 text-sm text-gray-400 mb-0.5">
                <a asp-action="Details" asp-route-id="@Model.StaffId" class="hover:text-orange-500">Staff Details</a>
                <span>/</span><span class="text-orange-500 font-medium">Reset Password</span>
            </div>
            <h1 class="text-2xl font-bold text-gray-900">@Model.StaffName</h1>
            <p class="text-sm text-gray-500 mt-1">@Model.Email</p>
        </div>
        <a asp-action="Details" asp-route-id="@Model.StaffId" class="rounded-xl border border-gray-200 px-4 py-2.5 text-sm font-semibold text-gray-600 hover:border-orange-200 hover:text-orange-600">Back</a>
    </div>

    <form asp-action="ResetPassword" asp-route-id="@Model.StaffId" method="post" class="bg-white rounded-2xl border border-orange-100 shadow-sm">
        @Html.AntiForgeryToken()
        <input asp-for="StaffId" type="hidden" />
        <input asp-for="StaffName" type="hidden" />
        <input asp-for="Email" type="hidden" />
        <div class="p-5 space-y-4">
            <div asp-validation-summary="ModelOnly" class="text-sm text-red-600"></div>
            <div class="rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-700">After reset, the staff member must use the new password on next login.</div>
            <div>
                <label asp-for="Password" class="block text-xs font-semibold text-gray-600 mb-1.5"></label>
                <input asp-for="Password" class="w-full px-3.5 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 bg-white" />
                <span asp-validation-for="Password" class="text-xs text-red-600"></span>
            </div>
            <div>
                <label asp-for="ConfirmPassword" class="block text-xs font-semibold text-gray-600 mb-1.5"></label>
                <input asp-for="ConfirmPassword" class="w-full px-3.5 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 bg-white" />
                <span asp-validation-for="ConfirmPassword" class="text-xs text-red-600"></span>
            </div>
        </div>
        <div class="flex gap-3 rounded-b-2xl bg-gray-50 px-5 py-4">
            <a asp-action="Details" asp-route-id="@Model.StaffId" class="flex-1 py-2.5 border border-gray-200 text-gray-600 text-sm font-semibold rounded-xl hover:bg-gray-50 text-center">Cancel</a>
            <button type="submit" class="flex-1 py-2.5 bg-gradient-to-r from-orange-500 to-amber-500 text-white text-sm font-semibold rounded-xl hover:from-orange-600 hover:to-amber-600">Reset Password</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
