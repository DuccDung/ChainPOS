@model ChainPOS.ViewModels.Owner.Staff.StaffDetailsViewModel
@{
    ViewData["Title"] = "Staff Details";
    ViewData["ActiveMenu"] = "staff";
    var initials = string.Join("", Model.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => x[0])).ToUpperInvariant();
    if (string.IsNullOrWhiteSpace(initials)) initials = "S";
}

<div class="space-y-5">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div class="flex items-center gap-3">
            <div class="w-14 h-14 bg-gradient-to-br from-orange-400 to-amber-400 rounded-2xl flex items-center justify-center text-white text-lg font-bold flex-shrink-0">@initials</div>
            <div>
                <div class="flex items-center gap-2 text-sm text-gray-400 mb-0.5">
                    <a asp-action="Index" class="hover:text-orange-500">Staff</a>
                    <span>/</span><span class="text-orange-500 font-medium">@Model.Email</span>
                </div>
                <h1 class="text-2xl font-bold text-gray-900">@Model.FullName</h1>
                <p class="text-sm text-gray-500">@Model.Email</p>
            </div>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <a asp-action="Index" class="rounded-xl border border-gray-200 px-4 py-2.5 text-sm font-semibold text-gray-600 hover:border-orange-200 hover:text-orange-600">Back</a>
            <a asp-action="ResetPassword" asp-route-id="@Model.Id" class="rounded-xl bg-orange-500 px-4 py-2.5 text-sm font-semibold text-white hover:bg-orange-600">Reset Password</a>
            @if (Model.IsLocked)
            {
                <form id="unlock-detail-@Model.Id" asp-action="Unlock" asp-route-id="@Model.Id" method="post" onsubmit="return openConfirmModal(this.id, 'Unlock staff', 'Allow this staff account to sign in again?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="rounded-xl bg-green-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-green-700">Unlock</button>
                </form>
            }
            else
            {
                <form id="lock-detail-@Model.Id" asp-action="Lock" asp-route-id="@Model.Id" method="post" onsubmit="return openConfirmModal(this.id, 'Lock staff', 'This staff account will not be able to sign in.');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="rounded-xl bg-red-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-red-700">Lock</button>
                </form>
            }
        </div>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white rounded-2xl p-4 border border-orange-100 shadow-sm">
            <p class="text-xs text-gray-400 mb-2">Status</p>
            <p class="text-2xl font-bold text-gray-900">@Model.Status</p>
        </div>
        <div class="bg-white rounded-2xl p-4 border border-orange-100 shadow-sm">
            <p class="text-xs text-gray-400 mb-2">Assigned Stores</p>
            <p class="text-2xl font-bold text-gray-900">@Model.StoreAssignments.Count</p>
        </div>
        <div class="bg-white rounded-2xl p-4 border border-orange-100 shadow-sm">
            <p class="text-xs text-gray-400 mb-2">Active Stores</p>
            <p class="text-2xl font-bold text-green-600">@Model.ActiveStoreCount</p>
        </div>
        <div class="bg-white rounded-2xl p-4 border border-orange-100 shadow-sm">
            <p class="text-xs text-gray-400 mb-2">Last Login</p>
            <p class="text-lg font-bold text-gray-900">@(Model.LastLoginAt?.ToLocalTime().ToString("dd/MM/yyyy") ?? "-")</p>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
        <section class="rounded-2xl border border-orange-100 bg-white p-5 shadow-sm">
            <h2 class="font-bold text-gray-900 mb-4">Staff Information</h2>
            <dl class="space-y-3 text-sm">
                <div class="flex justify-between gap-4"><dt class="text-gray-500">Email</dt><dd class="font-semibold text-gray-900">@Model.Email</dd></div>
                <div class="flex justify-between gap-4"><dt class="text-gray-500">Phone</dt><dd class="font-semibold text-gray-900">@(Model.PhoneNumber ?? "-")</dd></div>
                <div class="flex justify-between gap-4"><dt class="text-gray-500">Status</dt><dd class="font-semibold text-gray-900">@Model.Status</dd></div>
                <div class="flex justify-between gap-4"><dt class="text-gray-500">Created</dt><dd class="font-semibold text-gray-900">@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd></div>
                <div class="flex justify-between gap-4"><dt class="text-gray-500">Updated</dt><dd class="font-semibold text-gray-900">@(Model.UpdatedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "-")</dd></div>
            </dl>
        </section>

        <section class="rounded-2xl border border-orange-100 bg-white p-5 shadow-sm">
            <div class="flex items-center justify-between gap-3 mb-4">
                <h2 class="font-bold text-gray-900">Assign Store</h2>
                <span class="text-xs text-gray-400">@Model.AvailableStores.Count available</span>
            </div>
            @if (Model.AvailableStores.Count == 0)
            {
                <div class="rounded-xl border border-gray-100 bg-gray-50 px-4 py-3 text-sm text-gray-500">No unassigned stores available.</div>
            }
            else
            {
                <form asp-action="AssignStore" asp-route-id="@Model.Id" method="post" class="flex flex-col sm:flex-row gap-2">
                    @Html.AntiForgeryToken()
                    <select name="storeId" class="flex-1 px-3.5 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 bg-white">
                        @foreach (var store in Model.AvailableStores)
                        {
                            <option value="@store.StoreId">@store.StoreName (@store.StoreCode)</option>
                        }
                    </select>
                    <button type="submit" class="px-4 py-2.5 bg-gradient-to-r from-orange-500 to-amber-500 text-white text-sm font-semibold rounded-xl hover:from-orange-600 hover:to-amber-600">Assign</button>
                </form>
            }
        </section>
    </div>

    <section class="bg-white rounded-2xl border border-orange-100 shadow-sm overflow-hidden">
        <div class="flex items-center justify-between px-5 py-4 border-b border-gray-50">
            <div>
                <h3 class="font-bold text-gray-900">Store Access</h3>
                <p class="text-xs text-gray-400 mt-0.5">Staff can work only in active assigned stores.</p>
            </div>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full data-table text-sm">
                <thead>
                    <tr class="bg-amber-50 text-gray-500 text-xs font-semibold uppercase tracking-wider">
                        <th class="px-5 py-3 text-left">Store</th>
                        <th class="px-5 py-3 text-left">Code</th>
                        <th class="px-5 py-3 text-left">Assigned</th>
                        <th class="px-5 py-3 text-left">Access</th>
                        <th class="px-5 py-3 text-left">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-50">
                    @if (Model.StoreAssignments.Count == 0)
                    {
                        <tr>
                            <td colspan="5" class="px-5 py-10 text-center text-sm text-gray-400">No stores assigned.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var assignment in Model.StoreAssignments)
                        {
                            <tr class="hover:bg-orange-50/30">
                                <td class="px-5 py-3.5 font-semibold text-gray-800">@assignment.StoreName</td>
                                <td class="px-5 py-3.5 font-mono text-xs text-gray-500">@assignment.StoreCode</td>
                                <td class="px-5 py-3.5 text-gray-400 text-xs">@assignment.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                                <td class="px-5 py-3.5">
                                    @if (assignment.IsActive)
                                    {
                                        <span class="inline-flex rounded-full border border-green-100 bg-green-50 px-2.5 py-0.5 text-xs font-semibold text-green-700">Active</span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex rounded-full border border-red-100 bg-red-50 px-2.5 py-0.5 text-xs font-semibold text-red-700">Disabled</span>
                                    }
                                </td>
                                <td class="px-5 py-3.5">
                                    @if (assignment.IsActive)
                                    {
                                        <form id="disable-store-@assignment.UserStoreId" asp-action="DisableStore" asp-route-id="@Model.Id" method="post" onsubmit="return openConfirmModal(this.id, 'Disable store access', 'Staff will not be able to use this store.');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userStoreId" value="@assignment.UserStoreId" />
                                            <button type="submit" class="rounded-lg bg-red-50 px-3 py-1.5 text-xs font-semibold text-red-700 hover:bg-red-100">Disable</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form id="enable-store-@assignment.UserStoreId" asp-action="EnableStore" asp-route-id="@Model.Id" method="post" onsubmit="return openConfirmModal(this.id, 'Enable store access', 'Staff will be able to use this store again.');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userStoreId" value="@assignment.UserStoreId" />
                                            <button type="submit" class="rounded-lg bg-green-50 px-3 py-1.5 text-xs font-semibold text-green-700 hover:bg-green-100">Enable</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>
