@using ChainPOS.Constants
@model ChainPOS.ViewModels.Owner.Stores.StoreDetailsViewModel
@{
    ViewData["Title"] = "Store Details";
    ViewData["ActiveMenu"] = "stores";
}

<div class="space-y-5">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 text-sm text-gray-400 mb-0.5">
                <a asp-action="Index" class="hover:text-orange-500">Stores</a>
                <span>/</span><span class="text-orange-500 font-medium">@Model.Code</span>
            </div>
            <h1 class="text-2xl font-bold text-gray-900">@Model.Name</h1>
            <p class="text-sm text-gray-500 mt-1">@Model.Address</p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <a asp-action="Index" class="rounded-xl border border-gray-200 px-4 py-2.5 text-sm font-semibold text-gray-600 hover:border-orange-200 hover:text-orange-600">Back</a>
            <a asp-area="Owner" asp-controller="StoreProducts" asp-action="Index" asp-route-storeId="@Model.Id" class="rounded-xl border border-orange-200 bg-orange-50 px-4 py-2.5 text-sm font-semibold text-orange-700 hover:bg-orange-100">Products</a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="rounded-xl bg-orange-500 px-4 py-2.5 text-sm font-semibold text-white hover:bg-orange-600">Edit</a>
            @if (Model.Status != StoreStatuses.Active)
            {
                <form id="store-activate-@Model.Id" asp-action="Activate" asp-route-id="@Model.Id" method="post" onsubmit="return openConfirmModal(this.id, 'Activate store', 'This store will be available for operations.');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="rounded-xl bg-green-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-green-700">Activate</button>
                </form>
            }
            @if (Model.Status != StoreStatuses.Inactive)
            {
                <form id="store-deactivate-@Model.Id" asp-action="Deactivate" asp-route-id="@Model.Id" method="post" onsubmit="return openConfirmModal(this.id, 'Deactivate store', 'This store will be paused for operations.');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="rounded-xl bg-amber-500 px-4 py-2.5 text-sm font-semibold text-white hover:bg-amber-600">Deactivate</button>
                </form>
            }
            @if (Model.Status != StoreStatuses.Closed)
            {
                <form id="store-close-@Model.Id" asp-action="Close" asp-route-id="@Model.Id" method="post" onsubmit="return openConfirmModal(this.id, 'Close store', 'This store will be marked as closed.');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="rounded-xl bg-red-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-red-700">Close</button>
                </form>
            }
            <form id="store-delete-@Model.Id" asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return openConfirmModal(this.id, 'Delete store', 'This will soft delete the store but keep historical data.');">
                @Html.AntiForgeryToken()
                <button type="submit" class="rounded-xl border border-red-200 bg-red-50 px-4 py-2.5 text-sm font-semibold text-red-700 hover:bg-red-100">Delete</button>
            </form>
        </div>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white rounded-2xl p-4 border border-orange-100 shadow-sm">
            <p class="text-xs text-gray-400 mb-2">Staff Assigned</p>
            <p class="text-2xl font-bold text-gray-900">@Model.StaffCount</p>
        </div>
        <div class="bg-white rounded-2xl p-4 border border-orange-100 shadow-sm">
            <p class="text-xs text-gray-400 mb-2">Available Products</p>
            <p class="text-2xl font-bold text-gray-900">@Model.ProductCount</p>
        </div>
        <div class="bg-white rounded-2xl p-4 border border-orange-100 shadow-sm">
            <p class="text-xs text-gray-400 mb-2">Low Stock</p>
            <p class="text-2xl font-bold text-amber-500">@Model.LowStockCount</p>
        </div>
        <div class="bg-white rounded-2xl p-4 border border-orange-100 shadow-sm">
            <p class="text-xs text-gray-400 mb-2">Revenue</p>
            <p class="text-2xl font-bold text-gray-900">@Model.RevenueTotal.ToString("$#,##0.##")</p>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
        <section class="rounded-2xl border border-orange-100 bg-white p-5 shadow-sm">
            <h2 class="font-bold text-gray-900 mb-4">Store Information</h2>
            <dl class="space-y-3 text-sm">
                <div class="flex justify-between gap-4"><dt class="text-gray-500">Code</dt><dd class="font-mono font-semibold text-gray-900">@Model.Code</dd></div>
                <div class="flex justify-between gap-4"><dt class="text-gray-500">Status</dt><dd class="font-semibold text-gray-900">@Model.Status</dd></div>
                <div class="flex justify-between gap-4"><dt class="text-gray-500">Phone</dt><dd class="font-semibold text-gray-900">@(Model.Phone ?? "-")</dd></div>
                <div class="flex justify-between gap-4"><dt class="text-gray-500">Address</dt><dd class="font-semibold text-gray-900 text-right">@(Model.Address ?? "-")</dd></div>
                <div class="flex justify-between gap-4"><dt class="text-gray-500">Created</dt><dd class="font-semibold text-gray-900">@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd></div>
                <div class="flex justify-between gap-4"><dt class="text-gray-500">Updated</dt><dd class="font-semibold text-gray-900">@(Model.UpdatedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "-")</dd></div>
            </dl>
        </section>

        <section class="rounded-2xl border border-orange-100 bg-white p-5 shadow-sm">
            <h2 class="font-bold text-gray-900 mb-4">Operations Snapshot</h2>
            <dl class="space-y-3 text-sm">
                <div class="flex justify-between gap-4"><dt class="text-gray-500">Inventory items</dt><dd class="font-semibold text-gray-900">@Model.InventoryItemCount</dd></div>
                <div class="flex justify-between gap-4"><dt class="text-gray-500">Orders</dt><dd class="font-semibold text-gray-900">@Model.OrderCount</dd></div>
                <div class="flex justify-between gap-4"><dt class="text-gray-500">Available products</dt><dd class="font-semibold text-gray-900">@Model.ProductCount</dd></div>
                <div class="flex justify-between gap-4"><dt class="text-gray-500">Assigned staff</dt><dd class="font-semibold text-gray-900">@Model.StaffCount</dd></div>
            </dl>
        </section>
    </div>
</div>
