@model ChainPOS.ViewModels.Owner.StoreProducts.StoreProductAssignViewModel
@{
    ViewData["Title"] = "Assign Product";
    ViewData["ActiveMenu"] = "store-products";
}

<div class="max-w-4xl space-y-5">
    <div class="flex items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 text-sm text-gray-400 mb-0.5">
                <a asp-action="Index" class="hover:text-orange-500">Store Products</a>
                <span>/</span><span class="text-orange-500 font-medium">Assign Product</span>
            </div>
            <h1 class="text-2xl font-bold text-gray-900">Assign Product To Store</h1>
        </div>
        <a asp-action="Index" asp-route-storeId="@Model.StoreId" class="rounded-xl border border-gray-200 px-4 py-2.5 text-sm font-semibold text-gray-600 hover:border-orange-200 hover:text-orange-600">Back</a>
    </div>

    <form asp-action="Assign" method="post" class="bg-white rounded-2xl border border-orange-100 shadow-sm">
        @Html.AntiForgeryToken()
        <div class="p-5 space-y-4">
            <div asp-validation-summary="ModelOnly" class="text-sm text-red-600"></div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label asp-for="StoreId" class="block text-xs font-semibold text-gray-600 mb-1.5"></label>
                    <select asp-for="StoreId" class="w-full px-3.5 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 bg-white">
                        <option value="">Choose store</option>
                        @foreach (var store in Model.Stores)
                        {
                            <option value="@store.Id">@store.Name (@store.Code)</option>
                        }
                    </select>
                    <span asp-validation-for="StoreId" class="text-xs text-red-600"></span>
                </div>
                <div>
                    <label asp-for="ProductId" class="block text-xs font-semibold text-gray-600 mb-1.5"></label>
                    <select asp-for="ProductId" class="w-full px-3.5 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 bg-white">
                        <option value="">Choose product</option>
                        @foreach (var product in Model.Products)
                        {
                            <option value="@product.Id">@product.Name (@(product.Sku ?? "No SKU")) - @product.Price.ToString("#,##0.##")</option>
                        }
                    </select>
                    <span asp-validation-for="ProductId" class="text-xs text-red-600"></span>
                </div>
            </div>
            <div>
                <label asp-for="SellingPrice" class="block text-xs font-semibold text-gray-600 mb-1.5"></label>
                <input asp-for="SellingPrice" type="number" step="0.01" min="0" placeholder="Leave empty to use catalog price" class="w-full px-3.5 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 bg-white" />
                <span asp-validation-for="SellingPrice" class="text-xs text-red-600"></span>
                <p class="mt-1 text-xs text-gray-400">Empty selling price means this store uses the product catalog price.</p>
            </div>
            <label class="flex items-center gap-3 rounded-xl border border-gray-200 bg-gray-50 px-4 py-3 text-sm">
                <input asp-for="IsAvailable" class="w-4 h-4 accent-orange-500" />
                <span class="font-semibold text-gray-700">Available in this store</span>
            </label>
        </div>
        <div class="flex gap-3 rounded-b-2xl bg-gray-50 px-5 py-4">
            <a asp-action="Index" asp-route-storeId="@Model.StoreId" class="flex-1 py-2.5 border border-gray-200 text-gray-600 text-sm font-semibold rounded-xl hover:bg-gray-50 text-center">Cancel</a>
            <button type="submit" class="flex-1 py-2.5 bg-gradient-to-r from-orange-500 to-amber-500 text-white text-sm font-semibold rounded-xl hover:from-orange-600 hover:to-amber-600">Assign Product</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
