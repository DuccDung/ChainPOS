@model ChainPOS.ViewModels.Owner.StoreProducts.StoreProductEditViewModel
@{
    ViewData["Title"] = "Edit Store Product";
    ViewData["ActiveMenu"] = "store-products";
}

<div class="max-w-4xl space-y-5">
    <div class="flex items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 text-sm text-gray-400 mb-0.5">
                <a asp-action="Index" asp-route-storeId="@Model.StoreId" class="hover:text-orange-500">Store Products</a>
                <span>/</span><span class="text-orange-500 font-medium">Edit Assignment</span>
            </div>
            <h1 class="text-2xl font-bold text-gray-900">@Model.ProductName</h1>
            <p class="text-sm text-gray-500">@Model.StoreName (@Model.StoreCode)</p>
        </div>
        <a asp-action="Index" asp-route-storeId="@Model.StoreId" class="rounded-xl border border-gray-200 px-4 py-2.5 text-sm font-semibold text-gray-600 hover:border-orange-200 hover:text-orange-600">Back</a>
    </div>

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="bg-white rounded-2xl border border-orange-100 shadow-sm">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <input asp-for="StoreId" type="hidden" />
        <input asp-for="ProductId" type="hidden" />
        <input asp-for="StoreName" type="hidden" />
        <input asp-for="StoreCode" type="hidden" />
        <input asp-for="ProductName" type="hidden" />
        <input asp-for="Sku" type="hidden" />
        <input asp-for="BasePrice" type="hidden" />
        <div class="p-5 space-y-4">
            <div asp-validation-summary="ModelOnly" class="text-sm text-red-600"></div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="rounded-xl border border-orange-100 bg-orange-50/50 p-4">
                    <p class="text-xs text-gray-400 mb-2">Store</p>
                    <p class="font-bold text-gray-900">@Model.StoreName</p>
                    <p class="font-mono text-xs text-gray-500">@Model.StoreCode</p>
                </div>
                <div class="rounded-xl border border-orange-100 bg-orange-50/50 p-4">
                    <p class="text-xs text-gray-400 mb-2">Product</p>
                    <p class="font-bold text-gray-900">@Model.ProductName</p>
                    <p class="font-mono text-xs text-gray-500">@(Model.Sku ?? "No SKU")</p>
                </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1.5">Catalog Price</label>
                    <input value="@Model.BasePrice.ToString("#,##0.##")" disabled class="w-full px-3.5 py-2.5 border border-gray-200 rounded-xl text-sm bg-gray-50 text-gray-500" />
                </div>
                <div>
                    <label asp-for="SellingPrice" class="block text-xs font-semibold text-gray-600 mb-1.5"></label>
                    <input asp-for="SellingPrice" type="number" step="0.01" min="0" placeholder="Leave empty to use catalog price" class="w-full px-3.5 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 bg-white" />
                    <span asp-validation-for="SellingPrice" class="text-xs text-red-600"></span>
                </div>
            </div>
            <label class="flex items-center gap-3 rounded-xl border border-gray-200 bg-gray-50 px-4 py-3 text-sm">
                <input asp-for="IsAvailable" class="w-4 h-4 accent-orange-500" />
                <span class="font-semibold text-gray-700">Available in this store</span>
            </label>
        </div>
        <div class="flex gap-3 rounded-b-2xl bg-gray-50 px-5 py-4">
            <a asp-action="Index" asp-route-storeId="@Model.StoreId" class="flex-1 py-2.5 border border-gray-200 text-gray-600 text-sm font-semibold rounded-xl hover:bg-gray-50 text-center">Cancel</a>
            <button type="submit" class="flex-1 py-2.5 bg-gradient-to-r from-orange-500 to-amber-500 text-white text-sm font-semibold rounded-xl hover:from-orange-600 hover:to-amber-600">Save Changes</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
