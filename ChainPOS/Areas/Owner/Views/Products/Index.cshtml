@model ChainPOS.ViewModels.Owner.Products.ProductIndexViewModel
@{
    ViewData["Title"] = "Products";
    ViewData["ActiveMenu"] = "products";
}

<div class="flex flex-col gap-5">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 text-sm text-gray-400 mb-0.5">
                <a asp-area="Owner" asp-controller="Dashboard" asp-action="Index" class="hover:text-orange-500">Dashboard</a>
                <span>/</span><span class="text-gray-600 font-medium">Catalog</span>
                <span>/</span><span class="text-orange-500 font-medium">Products</span>
            </div>
            <h1 class="text-2xl font-bold text-gray-900">Product Management</h1>
        </div>
        <a asp-action="Create" class="inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-gradient-to-r from-orange-500 to-amber-500 text-white text-sm font-semibold rounded-xl hover:from-orange-600 hover:to-amber-600 transition-all shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            Add Product
        </a>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white rounded-2xl p-4 border border-orange-100 shadow-sm"><p class="text-xs text-gray-400 mb-2">Total Products</p><p class="text-2xl font-bold text-gray-900">@Model.TotalProducts</p><p class="text-xs text-gray-400 mt-1">@Model.CategoryCount categories</p></div>
        <div class="bg-white rounded-2xl p-4 border border-orange-100 shadow-sm"><p class="text-xs text-gray-400 mb-2">Active</p><p class="text-2xl font-bold text-green-600">@Model.ActiveProducts</p><p class="text-xs text-green-600 font-medium mt-1">Available for catalog</p></div>
        <div class="bg-white rounded-2xl p-4 border border-orange-100 shadow-sm"><p class="text-xs text-gray-400 mb-2">Inactive</p><p class="text-2xl font-bold text-amber-500">@Model.InactiveProducts</p><p class="text-xs text-amber-600 font-medium mt-1">Hidden from selling</p></div>
        <div class="bg-white rounded-2xl p-4 border border-orange-100 shadow-sm"><p class="text-xs text-gray-400 mb-2">Plan Limit</p><p class="text-2xl font-bold text-gray-900">@(Model.MaxProducts?.ToString() ?? "Unlimited")</p><p class="text-xs text-gray-400 mt-1">Products allowed</p></div>
    </div>

    @if (Model.MaxProducts.HasValue)
    {
        <div class="bg-amber-50 border border-amber-300 rounded-2xl p-4 flex items-start gap-3">
            <div class="w-8 h-8 bg-amber-100 rounded-xl flex items-center justify-center flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
            </div>
            <div>
                <p class="font-semibold text-amber-800 text-sm">Subscription product limit</p>
                <p class="text-xs text-amber-600 mt-0.5">Current plan allows @Model.MaxProducts product(s). You are using @Model.TotalProducts.</p>
            </div>
        </div>
    }

    <div class="bg-white rounded-2xl border border-orange-100 shadow-sm overflow-hidden">
        <div class="flex flex-col md:flex-row md:items-center justify-between px-5 py-4 gap-3 border-b border-gray-50">
            <div>
                <h3 class="font-bold text-gray-900">Product Inventory</h3>
                <p class="text-xs text-gray-400 mt-0.5">Showing @Model.Products.Count record(s)</p>
            </div>
            <form asp-action="Index" method="get" class="flex items-center gap-2 flex-wrap">
                <div class="relative">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-400 absolute left-3 top-1/2 -translate-y-1/2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0" />
                    </svg>
                    <input asp-for="Search" placeholder="Search products..." class="pl-9 pr-4 py-2 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 bg-gray-50 w-52" />
                </div>
                <select asp-for="CategoryId" class="px-3 py-2 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 bg-gray-50 text-gray-600">
                    <option value="">All Categories</option>
                    @foreach (var category in Model.Categories)
                    {
                        <option value="@category.Id">@category.Name</option>
                    }
                </select>
                <select asp-for="Status" class="px-3 py-2 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 bg-gray-50 text-gray-600">
                    <option value="">All Statuses</option>
                    <option value="active">Active</option>
                    <option value="inactive">Inactive</option>
                </select>
                <button type="submit" class="px-4 py-2 bg-orange-500 text-white text-sm font-semibold rounded-xl hover:bg-orange-600">Filter</button>
            </form>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full data-table text-sm">
                <thead>
                    <tr class="bg-amber-50 text-gray-500 text-xs font-semibold uppercase tracking-wider">
                        <th class="px-5 py-3 text-left">Product</th>
                        <th class="px-5 py-3 text-left">SKU</th>
                        <th class="px-5 py-3 text-left">Barcode</th>
                        <th class="px-5 py-3 text-left">Category</th>
                        <th class="px-5 py-3 text-right">Price</th>
                        <th class="px-5 py-3 text-right">Cost</th>
                        <th class="px-5 py-3 text-center">Stock</th>
                        <th class="px-5 py-3 text-left">Status</th>
                        <th class="px-5 py-3 text-left">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-50">
                    @if (Model.Products.Count == 0)
                    {
                        <tr><td colspan="9" class="px-5 py-10 text-center text-sm text-gray-400">No products found.</td></tr>
                    }
                    else
                    {
                        foreach (var product in Model.Products)
                        {
                            <tr class="hover:bg-orange-50/30">
                                <td class="px-5 py-3.5">
                                    <div class="flex items-center gap-3">
                                        @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                                        {
                                            <img src="@product.ImageUrl" alt="@product.Name" class="w-10 h-10 rounded-xl object-cover border border-orange-100 flex-shrink-0" />
                                        }
                                        else
                                        {
                                            <div class="w-10 h-10 bg-gradient-to-br from-orange-400 to-amber-400 rounded-xl flex items-center justify-center text-white text-sm font-bold flex-shrink-0">@product.Name[0]</div>
                                        }
                                        <div>
                                            <p class="font-semibold text-gray-800 text-sm">@product.Name</p>
                                            <p class="text-xs text-gray-400">@product.StoreCount store(s)</p>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-5 py-3.5 font-mono text-xs text-gray-500">@(product.Sku ?? "-")</td>
                                <td class="px-5 py-3.5 font-mono text-xs text-gray-500">@(product.Barcode ?? "-")</td>
                                <td class="px-5 py-3.5"><span class="px-2.5 py-1 bg-orange-50 text-orange-700 rounded-lg text-xs font-semibold">@(product.CategoryName ?? "Uncategorized")</span></td>
                                <td class="px-5 py-3.5 text-right font-semibold text-gray-900">@product.Price.ToString("#,##0.##")</td>
                                <td class="px-5 py-3.5 text-right font-semibold text-gray-900">@product.CostPrice.ToString("#,##0.##")</td>
                                <td class="px-5 py-3.5 text-center">
                                    <div class="flex flex-col items-center gap-1">
                                        <span class="font-bold text-gray-900">@product.InventoryQuantity.ToString("#,##0.##")</span>
                                        <span class="text-xs text-gray-400">@product.InventoryItemCount store stock</span>
                                    </div>
                                </td>
                                <td class="px-5 py-3.5">
                                    @if (product.IsActive)
                                    {
                                        <span class="inline-flex rounded-full border border-green-100 bg-green-50 px-2.5 py-0.5 text-xs font-semibold text-green-700">Active</span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex rounded-full border border-amber-100 bg-amber-50 px-2.5 py-0.5 text-xs font-semibold text-amber-700">Inactive</span>
                                    }
                                </td>
                                <td class="px-5 py-3.5">
                                    <div class="flex items-center gap-1">
                                        <a asp-action="Details" asp-route-id="@product.Id" class="p-1.5 rounded-lg hover:bg-orange-50 text-gray-400 hover:text-orange-500 transition-colors" title="View">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@product.Id" class="p-1.5 rounded-lg hover:bg-amber-50 text-gray-400 hover:text-amber-500 transition-colors" title="Edit">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <div class="flex items-center justify-between px-5 py-3 border-t border-gray-50 text-xs text-gray-400">
            <span>Showing @Model.Products.Count of @Model.TotalProducts products</span>
            <div class="flex items-center gap-1">
                <button class="px-3 py-1.5 rounded-lg text-gray-300" type="button" disabled>Prev</button>
                <button class="px-3 py-1.5 rounded-lg bg-orange-500 text-white font-semibold" type="button">1</button>
                <button class="px-3 py-1.5 rounded-lg text-gray-300" type="button" disabled>Next</button>
            </div>
        </div>
    </div>
</div>
