@model ChainPOS.ViewModels.Owner.Products.ProductFormViewModel
@{
    ViewData["Title"] = "Add Product";
    ViewData["ActiveMenu"] = "products";
}

<div class="max-w-5xl space-y-5">
    <div class="flex items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 text-sm text-gray-400 mb-0.5">
                <a asp-action="Index" class="hover:text-orange-500">Products</a>
                <span>/</span><span class="text-orange-500 font-medium">Add Product</span>
            </div>
            <h1 class="text-2xl font-bold text-gray-900">Add New Product</h1>
        </div>
        <a asp-action="Index" class="rounded-xl border border-gray-200 px-4 py-2.5 text-sm font-semibold text-gray-600 hover:border-orange-200 hover:text-orange-600">Back</a>
    </div>

    <form asp-action="Create" method="post" enctype="multipart/form-data" class="bg-white rounded-2xl border border-orange-100 shadow-sm">
        @Html.AntiForgeryToken()
        <div class="p-5 space-y-4">
            <div asp-validation-summary="ModelOnly" class="text-sm text-red-600"></div>
            <div>
                <label asp-for="Name" class="block text-xs font-semibold text-gray-600 mb-1.5"></label>
                <input asp-for="Name" placeholder="e.g. Laptop Stand Pro" class="w-full px-3.5 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 bg-white" />
                <span asp-validation-for="Name" class="text-xs text-red-600"></span>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div>
                    <label asp-for="Sku" class="block text-xs font-semibold text-gray-600 mb-1.5"></label>
                    <input asp-for="Sku" placeholder="SKU-001" class="w-full px-3.5 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 bg-white" />
                    <span asp-validation-for="Sku" class="text-xs text-red-600"></span>
                </div>
                <div>
                    <label asp-for="Barcode" class="block text-xs font-semibold text-gray-600 mb-1.5"></label>
                    <input asp-for="Barcode" placeholder="893..." class="w-full px-3.5 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 bg-white" />
                    <span asp-validation-for="Barcode" class="text-xs text-red-600"></span>
                </div>
                <div>
                    <label asp-for="CategoryId" class="block text-xs font-semibold text-gray-600 mb-1.5"></label>
                    <select asp-for="CategoryId" class="w-full px-3.5 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 bg-white">
                        <option value="">Uncategorized</option>
                        @foreach (var category in Model.Categories)
                        {
                            <option value="@category.Id">@category.Name</option>
                        }
                    </select>
                    <span asp-validation-for="CategoryId" class="text-xs text-red-600"></span>
                </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label asp-for="Price" class="block text-xs font-semibold text-gray-600 mb-1.5"></label>
                    <input asp-for="Price" type="number" step="0.01" min="0" class="w-full px-3.5 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 bg-white" />
                    <span asp-validation-for="Price" class="text-xs text-red-600"></span>
                </div>
                <div>
                    <label asp-for="CostPrice" class="block text-xs font-semibold text-gray-600 mb-1.5"></label>
                    <input asp-for="CostPrice" type="number" step="0.01" min="0" class="w-full px-3.5 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 bg-white" />
                    <span asp-validation-for="CostPrice" class="text-xs text-red-600"></span>
                </div>
            </div>
            <div>
                <label asp-for="Description" class="block text-xs font-semibold text-gray-600 mb-1.5"></label>
                <textarea asp-for="Description" rows="4" placeholder="Short product description..." class="w-full px-3.5 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 bg-white"></textarea>
                <span asp-validation-for="Description" class="text-xs text-red-600"></span>
            </div>
            <div>
                <label asp-for="ImageFile" class="block text-xs font-semibold text-gray-600 mb-1.5"></label>
                <input asp-for="ImageFile" type="file" accept="image/*" class="block w-full text-sm text-gray-600 file:mr-4 file:rounded-xl file:border-0 file:bg-orange-50 file:px-4 file:py-2.5 file:text-sm file:font-semibold file:text-orange-700 hover:file:bg-orange-100" />
                <span asp-validation-for="ImageFile" class="text-xs text-red-600"></span>
                <p class="mt-1 text-xs text-gray-400">JPG, PNG, WEBP or GIF. Max 5MB.</p>
            </div>
            <label class="flex items-center gap-3 rounded-xl border border-gray-200 bg-gray-50 px-4 py-3 text-sm">
                <input asp-for="IsActive" class="w-4 h-4 accent-orange-500" />
                <span class="font-semibold text-gray-700">Active product</span>
            </label>
        </div>
        <div class="flex gap-3 rounded-b-2xl bg-gray-50 px-5 py-4">
            <a asp-action="Index" class="flex-1 py-2.5 border border-gray-200 text-gray-600 text-sm font-semibold rounded-xl hover:bg-gray-50 text-center">Cancel</a>
            <button type="submit" class="flex-1 py-2.5 bg-gradient-to-r from-orange-500 to-amber-500 text-white text-sm font-semibold rounded-xl hover:from-orange-600 hover:to-amber-600">Add Product</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
