@model ChainPOS.ViewModels.Owner.Products.ProductDetailsViewModel
@{
    ViewData["Title"] = "Product Details";
    ViewData["ActiveMenu"] = "products";
}

<div class="space-y-5">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div class="flex items-center gap-3">
            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" alt="@Model.Name" class="w-16 h-16 rounded-2xl object-cover border border-orange-100 flex-shrink-0" />
            }
            else
            {
                <div class="w-16 h-16 bg-gradient-to-br from-orange-400 to-amber-400 rounded-2xl flex items-center justify-center text-white text-lg font-bold flex-shrink-0">@Model.Name[0]</div>
            }
            <div>
                <div class="flex items-center gap-2 text-sm text-gray-400 mb-0.5">
                    <a asp-action="Index" class="hover:text-orange-500">Products</a>
                    <span>/</span><span class="text-orange-500 font-medium">@Model.Name</span>
                </div>
                <h1 class="text-2xl font-bold text-gray-900">@Model.Name</h1>
                <p class="text-sm text-gray-500">@(Model.Sku ?? "No SKU") / @(Model.CategoryName ?? "Uncategorized")</p>
            </div>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <a asp-action="Index" class="rounded-xl border border-gray-200 px-4 py-2.5 text-sm font-semibold text-gray-600 hover:border-orange-200 hover:text-orange-600">Back</a>
            <a asp-area="Owner" asp-controller="StoreProducts" asp-action="Assign" asp-route-productId="@Model.Id" class="rounded-xl border border-orange-200 bg-orange-50 px-4 py-2.5 text-sm font-semibold text-orange-700 hover:bg-orange-100">Assign Store</a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="rounded-xl bg-orange-500 px-4 py-2.5 text-sm font-semibold text-white hover:bg-orange-600">Edit</a>
            @if (Model.IsActive)
            {
                <form id="product-deactivate-@Model.Id" asp-action="Deactivate" asp-route-id="@Model.Id" method="post" onsubmit="return openConfirmModal(this.id, 'Deactivate product', 'This product will be hidden from active catalog choices.');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="rounded-xl bg-amber-500 px-4 py-2.5 text-sm font-semibold text-white hover:bg-amber-600">Deactivate</button>
                </form>
            }
            else
            {
                <form id="product-activate-@Model.Id" asp-action="Activate" asp-route-id="@Model.Id" method="post" onsubmit="return openConfirmModal(this.id, 'Activate product', 'This product will be available for assignment and selling.');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="rounded-xl bg-green-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-green-700">Activate</button>
                </form>
            }
            <form id="product-delete-@Model.Id" asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return openConfirmModal(this.id, 'Delete product', 'This will soft delete the product but keep historical sales and stock data.');">
                @Html.AntiForgeryToken()
                <button type="submit" class="rounded-xl border border-red-200 bg-red-50 px-4 py-2.5 text-sm font-semibold text-red-700 hover:bg-red-100">Delete</button>
            </form>
        </div>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white rounded-2xl p-4 border border-orange-100 shadow-sm">
            <p class="text-xs text-gray-400 mb-2">Status</p>
            <p class="text-2xl font-bold @(Model.IsActive ? "text-green-600" : "text-amber-500")">@(Model.IsActive ? "Active" : "Inactive")</p>
        </div>
        <div class="bg-white rounded-2xl p-4 border border-orange-100 shadow-sm">
            <p class="text-xs text-gray-400 mb-2">Price</p>
            <p class="text-2xl font-bold text-gray-900">@Model.Price.ToString("#,##0.##")</p>
        </div>
        <div class="bg-white rounded-2xl p-4 border border-orange-100 shadow-sm">
            <p class="text-xs text-gray-400 mb-2">Cost</p>
            <p class="text-2xl font-bold text-gray-900">@Model.CostPrice.ToString("#,##0.##")</p>
        </div>
        <div class="bg-white rounded-2xl p-4 border border-orange-100 shadow-sm">
            <p class="text-xs text-gray-400 mb-2">Stock</p>
            <p class="text-2xl font-bold text-gray-900">@Model.InventoryQuantity.ToString("#,##0.##")</p>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
        <section class="rounded-2xl border border-orange-100 bg-white p-5 shadow-sm">
            <h2 class="font-bold text-gray-900 mb-4">Product Information</h2>
            <dl class="space-y-3 text-sm">
                <div class="flex justify-between gap-4"><dt class="text-gray-500">Name</dt><dd class="font-semibold text-gray-900 text-right">@Model.Name</dd></div>
                <div class="flex justify-between gap-4"><dt class="text-gray-500">SKU</dt><dd class="font-semibold text-gray-900">@(Model.Sku ?? "-")</dd></div>
                <div class="flex justify-between gap-4"><dt class="text-gray-500">Barcode</dt><dd class="font-semibold text-gray-900">@(Model.Barcode ?? "-")</dd></div>
                <div class="flex justify-between gap-4"><dt class="text-gray-500">Category</dt><dd class="font-semibold text-gray-900">@(Model.CategoryName ?? "Uncategorized")</dd></div>
                <div class="flex justify-between gap-4"><dt class="text-gray-500">Description</dt><dd class="font-semibold text-gray-900 text-right">@(Model.Description ?? "-")</dd></div>
            </dl>
        </section>

        <section class="rounded-2xl border border-orange-100 bg-white p-5 shadow-sm">
            <h2 class="font-bold text-gray-900 mb-4">Usage</h2>
            <dl class="space-y-3 text-sm">
                <div class="flex justify-between gap-4"><dt class="text-gray-500">Assigned Stores</dt><dd class="font-semibold text-gray-900">@Model.StoreCount</dd></div>
                <div class="flex justify-between gap-4"><dt class="text-gray-500">Inventory Rows</dt><dd class="font-semibold text-gray-900">@Model.InventoryItemCount</dd></div>
                <div class="flex justify-between gap-4"><dt class="text-gray-500">Order Lines</dt><dd class="font-semibold text-gray-900">@Model.OrderItemCount</dd></div>
                <div class="flex justify-between gap-4"><dt class="text-gray-500">Created</dt><dd class="font-semibold text-gray-900">@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd></div>
                <div class="flex justify-between gap-4"><dt class="text-gray-500">Updated</dt><dd class="font-semibold text-gray-900">@(Model.UpdatedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "-")</dd></div>
            </dl>
        </section>
    </div>
</div>
