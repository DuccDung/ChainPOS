@model ChainPOS.ViewModels.Owner.Categories.CategoryFormViewModel
@{
    ViewData["Title"] = "Edit Category";
    ViewData["ActiveMenu"] = "categories";
}

<div class="max-w-4xl space-y-5">
    <div class="flex items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 text-sm text-gray-400 mb-0.5">
                <a asp-action="Index" class="hover:text-orange-500">Categories</a>
                <span>/</span><span class="text-orange-500 font-medium">Edit Category</span>
            </div>
            <h1 class="text-2xl font-bold text-gray-900">@Model.Name</h1>
        </div>
        <a asp-action="Details" asp-route-id="@Model.Id" class="rounded-xl border border-gray-200 px-4 py-2.5 text-sm font-semibold text-gray-600 hover:border-orange-200 hover:text-orange-600">Details</a>
    </div>

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="bg-white rounded-2xl border border-orange-100 shadow-sm">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <div class="p-5 space-y-4">
            <div asp-validation-summary="ModelOnly" class="text-sm text-red-600"></div>
            <div>
                <label asp-for="Name" class="block text-xs font-semibold text-gray-600 mb-1.5"></label>
                <input asp-for="Name" class="w-full px-3.5 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 bg-white" />
                <span asp-validation-for="Name" class="text-xs text-red-600"></span>
            </div>
            <div>
                <label asp-for="Description" class="block text-xs font-semibold text-gray-600 mb-1.5"></label>
                <textarea asp-for="Description" rows="4" class="w-full px-3.5 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 bg-white"></textarea>
                <span asp-validation-for="Description" class="text-xs text-red-600"></span>
            </div>
            <label class="flex items-center gap-3 rounded-xl border border-gray-200 bg-gray-50 px-4 py-3 text-sm">
                <input asp-for="IsActive" class="w-4 h-4 accent-orange-500" />
                <span class="font-semibold text-gray-700">Active category</span>
            </label>
        </div>
        <div class="flex gap-3 rounded-b-2xl bg-gray-50 px-5 py-4">
            <a asp-action="Details" asp-route-id="@Model.Id" class="flex-1 py-2.5 border border-gray-200 text-gray-600 text-sm font-semibold rounded-xl hover:bg-gray-50 text-center">Cancel</a>
            <button type="submit" class="flex-1 py-2.5 bg-gradient-to-r from-orange-500 to-amber-500 text-white text-sm font-semibold rounded-xl hover:from-orange-600 hover:to-amber-600">Save Changes</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
