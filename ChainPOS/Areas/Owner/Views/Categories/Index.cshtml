@model ChainPOS.ViewModels.Owner.Categories.CategoryIndexViewModel
@{
    ViewData["Title"] = "Categories";
    ViewData["ActiveMenu"] = "categories";
}

<div class="flex flex-col gap-5">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 text-sm text-gray-400 mb-0.5">
                <a asp-area="Owner" asp-controller="Dashboard" asp-action="Index" class="hover:text-orange-500">Dashboard</a>
                <span>/</span><span class="text-gray-600 font-medium">Catalog</span>
                <span>/</span><span class="text-orange-500 font-medium">Categories</span>
            </div>
            <h1 class="text-2xl font-bold text-gray-900">Category Management</h1>
        </div>
        <a asp-action="Create" class="inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-gradient-to-r from-orange-500 to-amber-500 text-white text-sm font-semibold rounded-xl hover:from-orange-600 hover:to-amber-600 transition-all shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            Add Category
        </a>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white rounded-2xl p-4 border border-orange-100 shadow-sm"><p class="text-xs text-gray-400 mb-2">Total Categories</p><p class="text-2xl font-bold text-gray-900">@Model.TotalCategories</p></div>
        <div class="bg-white rounded-2xl p-4 border border-orange-100 shadow-sm"><p class="text-xs text-gray-400 mb-2">Active</p><p class="text-2xl font-bold text-green-600">@Model.ActiveCategories</p></div>
        <div class="bg-white rounded-2xl p-4 border border-orange-100 shadow-sm"><p class="text-xs text-gray-400 mb-2">Inactive</p><p class="text-2xl font-bold text-amber-500">@Model.InactiveCategories</p></div>
        <div class="bg-white rounded-2xl p-4 border border-orange-100 shadow-sm"><p class="text-xs text-gray-400 mb-2">Products</p><p class="text-2xl font-bold text-gray-900">@Model.ProductCount</p></div>
    </div>

    <div class="bg-white rounded-2xl border border-orange-100 shadow-sm overflow-hidden">
        <div class="flex flex-col md:flex-row md:items-center justify-between px-5 py-4 gap-3 border-b border-gray-50">
            <div>
                <h3 class="font-bold text-gray-900">All Categories</h3>
                <p class="text-xs text-gray-400 mt-0.5">Showing @Model.Categories.Count record(s)</p>
            </div>
            <form asp-action="Index" method="get" class="flex items-center gap-2 flex-wrap">
                <div class="relative">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-400 absolute left-3 top-1/2 -translate-y-1/2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0" />
                    </svg>
                    <input asp-for="Search" placeholder="Search categories..." class="pl-9 pr-4 py-2 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 bg-gray-50 w-52" />
                </div>
                <select asp-for="Status" class="px-3 py-2 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 bg-gray-50 text-gray-600">
                    <option value="">All Statuses</option>
                    <option value="active">Active</option>
                    <option value="inactive">Inactive</option>
                </select>
                <button type="submit" class="px-4 py-2 bg-orange-500 text-white text-sm font-semibold rounded-xl hover:bg-orange-600">Filter</button>
            </form>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full data-table text-sm">
                <thead>
                    <tr class="bg-amber-50 text-gray-500 text-xs font-semibold uppercase tracking-wider">
                        <th class="px-5 py-3 text-left">Category</th>
                        <th class="px-5 py-3 text-left">Description</th>
                        <th class="px-5 py-3 text-right">Products</th>
                        <th class="px-5 py-3 text-left">Created</th>
                        <th class="px-5 py-3 text-left">Status</th>
                        <th class="px-5 py-3 text-left">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-50">
                    @if (Model.Categories.Count == 0)
                    {
                        <tr><td colspan="6" class="px-5 py-10 text-center text-sm text-gray-400">No categories found.</td></tr>
                    }
                    else
                    {
                        foreach (var category in Model.Categories)
                        {
                            <tr class="hover:bg-orange-50/30">
                                <td class="px-5 py-3.5">
                                    <div class="flex items-center gap-3">
                                        <div class="w-9 h-9 bg-gradient-to-br from-orange-400 to-amber-400 rounded-xl flex items-center justify-center text-white text-sm font-bold flex-shrink-0">@category.Name[0]</div>
                                        <span class="font-semibold text-gray-800">@category.Name</span>
                                    </div>
                                </td>
                                <td class="px-5 py-3.5 text-gray-500 max-w-md truncate">@(category.Description ?? "-")</td>
                                <td class="px-5 py-3.5 text-right font-semibold text-gray-900">@category.ProductCount</td>
                                <td class="px-5 py-3.5 text-gray-400 text-xs">@category.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                                <td class="px-5 py-3.5">
                                    @if (category.IsActive)
                                    {
                                        <span class="inline-flex rounded-full border border-green-100 bg-green-50 px-2.5 py-0.5 text-xs font-semibold text-green-700">Active</span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex rounded-full border border-amber-100 bg-amber-50 px-2.5 py-0.5 text-xs font-semibold text-amber-700">Inactive</span>
                                    }
                                </td>
                                <td class="px-5 py-3.5">
                                    <div class="flex items-center gap-1">
                                        <a asp-action="Details" asp-route-id="@category.Id" class="p-1.5 rounded-lg hover:bg-orange-50 text-gray-400 hover:text-orange-500 transition-colors" title="View">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@category.Id" class="p-1.5 rounded-lg hover:bg-amber-50 text-gray-400 hover:text-amber-500 transition-colors" title="Edit">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <div class="flex items-center justify-between px-5 py-3 border-t border-gray-50 text-xs text-gray-400">
            <span>Showing @Model.Categories.Count of @Model.TotalCategories categories</span>
            <div class="flex items-center gap-1">
                <button class="px-3 py-1.5 rounded-lg text-gray-300" type="button" disabled>Prev</button>
                <button class="px-3 py-1.5 rounded-lg bg-orange-500 text-white font-semibold" type="button">1</button>
                <button class="px-3 py-1.5 rounded-lg text-gray-300" type="button" disabled>Next</button>
            </div>
        </div>
    </div>
</div>
