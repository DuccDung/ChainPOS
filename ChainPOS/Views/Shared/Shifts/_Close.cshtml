@model ChainPOS.ViewModels.Sales.ShiftCloseViewModel

<div class="max-w-3xl space-y-5">
    <div class="flex items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 text-sm text-gray-400 mb-0.5">
                <a asp-area="@Model.AreaName" asp-controller="Shifts" asp-action="Index" class="hover:text-orange-500">Shifts</a>
                <span>/</span><span class="text-orange-500 font-medium">Close Shift</span>
            </div>
            <h1 class="text-2xl font-bold text-gray-900">Close Shift</h1>
        </div>
        <a asp-area="@Model.AreaName" asp-controller="Shifts" asp-action="Index" class="rounded-xl border border-gray-200 px-4 py-2.5 text-sm font-semibold text-gray-600 hover:border-orange-200 hover:text-orange-600">Back</a>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white rounded-2xl p-4 border border-orange-100 shadow-sm"><p class="text-xs text-gray-400 mb-2">Opening Cash</p><p class="text-2xl font-bold text-gray-900">@Model.OpeningCash.ToString("#,##0.##")</p></div>
        <div class="bg-white rounded-2xl p-4 border border-orange-100 shadow-sm"><p class="text-xs text-gray-400 mb-2">Cash Sales</p><p class="text-2xl font-bold text-green-600">@Model.CashSales.ToString("#,##0.##")</p></div>
        <div class="bg-white rounded-2xl p-4 border border-orange-100 shadow-sm"><p class="text-xs text-gray-400 mb-2">Expected Cash</p><p class="text-2xl font-bold text-gray-900">@Model.ExpectedCash.ToString("#,##0.##")</p></div>
        <div class="bg-white rounded-2xl p-4 border border-orange-100 shadow-sm"><p class="text-xs text-gray-400 mb-2">Store</p><p class="text-sm font-bold text-gray-900">@Model.StoreName</p><p class="text-xs text-gray-400 mt-1">@Model.StoreCode</p></div>
    </div>

    <form asp-area="@Model.AreaName" asp-controller="Shifts" asp-action="Close" asp-route-id="@Model.Id" method="post" class="bg-white rounded-2xl border border-orange-100 shadow-sm">
        @Html.AntiForgeryToken()
        <input asp-for="AreaName" type="hidden" />
        <input asp-for="Id" type="hidden" />
        <input asp-for="ExpectedCash" type="hidden" />
        <div class="p-5 space-y-4">
            <div asp-validation-summary="ModelOnly" class="text-sm text-red-600"></div>
            <div>
                <label asp-for="ClosingCash" class="block text-xs font-semibold text-gray-600 mb-1.5"></label>
                <input asp-for="ClosingCash" type="number" step="0.01" min="0" class="w-full px-3.5 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 bg-white" />
                <span asp-validation-for="ClosingCash" class="text-xs text-red-600"></span>
            </div>
            <div class="rounded-2xl border border-amber-200 bg-amber-50 p-4">
                <p class="text-xs font-semibold text-amber-700 uppercase tracking-wider mb-1">Difference Preview</p>
                <p class="text-sm text-amber-700">Difference is calculated on the server from closing cash minus expected cash.</p>
            </div>
        </div>
        <div class="flex gap-3 rounded-b-2xl bg-gray-50 px-5 py-4">
            <a asp-area="@Model.AreaName" asp-controller="Shifts" asp-action="Index" class="flex-1 py-2.5 border border-gray-200 text-gray-600 text-sm font-semibold rounded-xl hover:bg-gray-50 text-center">Cancel</a>
            <button type="submit" class="flex-1 py-2.5 bg-gradient-to-r from-orange-500 to-amber-500 text-white text-sm font-semibold rounded-xl hover:from-orange-600 hover:to-amber-600">Close Shift</button>
        </div>
    </form>
</div>
