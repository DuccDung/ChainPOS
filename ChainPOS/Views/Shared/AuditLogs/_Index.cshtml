@model ChainPOS.ViewModels.Audit.AuditLogIndexViewModel
@{
    string DateText(DateOnly? value) => value?.ToString("yyyy-MM-dd") ?? string.Empty;
    string DateTimeText(DateTime value) => value.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss");
    string Initial(string value) => string.IsNullOrWhiteSpace(value) ? "S" : value.Trim()[0].ToString().ToUpperInvariant();
    string StoreText(ChainPOS.ViewModels.Audit.AuditLogListItemViewModel item)
        => string.IsNullOrWhiteSpace(item.StoreName) ? "-" : $"{item.StoreName} ({item.StoreCode})";

    string ActionBadge(string group) => group switch
    {
        "CREATE" => "bg-green-50 text-green-700",
        "UPDATE" => "bg-blue-50 text-blue-700",
        "DELETE" => "bg-red-50 text-red-600",
        "EXPORT" => "bg-amber-50 text-amber-700",
        _ => "bg-gray-100 text-gray-600"
    };

    string SeverityBadge(string severity) => severity switch
    {
        "critical" => "bg-red-50 text-red-700 border-red-100",
        "warning" => "bg-amber-50 text-amber-700 border-amber-100",
        _ => "bg-emerald-50 text-emerald-700 border-emerald-100"
    };

    var fromDateValue = DateText(Model.Filter.FromDate);
    var toDateValue = DateText(Model.Filter.ToDate);
    var periodText = $"{Model.Filter.FromDate?.ToString("dd/MM")} - {Model.Filter.ToDate?.ToString("dd/MM")}";
    var tableColspan = Model.IsAdmin ? 10 : 9;
}

<div class="flex flex-col gap-5">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 text-sm text-gray-400 mb-0.5">
                <a asp-area="@Model.AreaName" asp-controller="Dashboard" asp-action="Index" class="hover:text-orange-500">Dashboard</a>
                <span>/</span><span class="text-orange-500 font-medium">Audit Logs</span>
            </div>
            <h1 class="text-2xl font-bold text-gray-900">Audit Trail</h1>
            <p class="text-sm text-gray-500 mt-1">Review user actions, store activity and platform events.</p>
        </div>
        <div class="flex items-center gap-2 bg-gray-50 border border-gray-200 rounded-xl p-1">
            <span class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-orange-500 text-white shadow-sm">@periodText</span>
            <a asp-area="@Model.AreaName" asp-controller="AuditLogs" asp-action="Index" class="px-3 py-1.5 rounded-lg text-xs font-semibold text-gray-500 hover:bg-white">Reset</a>
        </div>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white rounded-2xl p-4 border border-orange-100 shadow-sm flex items-center gap-3">
            <div class="w-10 h-10 bg-orange-100 rounded-xl flex items-center justify-center flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-orange-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" /></svg>
            </div>
            <div>
                <p class="text-2xl font-bold text-gray-900">@Model.TotalEvents</p>
                <p class="text-xs text-gray-500">Events in range</p>
            </div>
        </div>
        <div class="bg-white rounded-2xl p-4 border border-orange-100 shadow-sm flex items-center gap-3">
            <div class="w-10 h-10 bg-blue-100 rounded-xl flex items-center justify-center flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M15 7a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
            </div>
            <div>
                <p class="text-2xl font-bold text-gray-900">@Model.DistinctUsers</p>
                <p class="text-xs text-gray-500">Users involved</p>
            </div>
        </div>
        <div class="bg-white rounded-2xl p-4 border border-orange-100 shadow-sm flex items-center gap-3">
            <div class="w-10 h-10 bg-amber-100 rounded-xl flex items-center justify-center flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
            </div>
            <div>
                <p class="text-2xl font-bold text-gray-900">@Model.WarningEvents</p>
                <p class="text-xs text-gray-500">Warnings</p>
            </div>
        </div>
        <div class="bg-white rounded-2xl p-4 border border-orange-100 shadow-sm flex items-center gap-3">
            <div class="w-10 h-10 bg-red-100 rounded-xl flex items-center justify-center flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" /></svg>
            </div>
            <div>
                <p class="text-2xl font-bold text-gray-900">@Model.CriticalEvents</p>
                <p class="text-xs text-gray-500">Critical events</p>
            </div>
        </div>
    </div>

    <div class="bg-white rounded-2xl border border-orange-100 shadow-sm overflow-hidden">
        <div class="px-5 py-4 border-b border-gray-50">
            <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-3">
                <div>
                    <h3 class="font-bold text-gray-900">System Audit Log</h3>
                    <p class="text-xs text-gray-400 mt-0.5">Showing @Model.Logs.Count of @Model.TotalEvents matching event(s)</p>
                </div>
                <form asp-area="@Model.AreaName" asp-controller="AuditLogs" asp-action="Index" method="get" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-7 gap-2 lg:max-w-6xl">
                    @if (Model.IsAdmin)
                    {
                        <select name="TenantId" class="px-3 py-2 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 bg-gray-50 text-gray-600">
                            <option value="">All Tenants</option>
                            @foreach (var tenant in Model.Tenants)
                            {
                                <option value="@tenant.Id" selected="@(Model.Filter.TenantId == tenant.Id)">@tenant.Name</option>
                            }
                        </select>
                    }
                    <select name="StoreId" class="px-3 py-2 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 bg-gray-50 text-gray-600">
                        <option value="">All Stores</option>
                        @foreach (var store in Model.Stores)
                        {
                            <option value="@store.Id" selected="@(Model.Filter.StoreId == store.Id)">@store.Name (@store.Code)</option>
                        }
                    </select>
                    <select name="UserId" class="px-3 py-2 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 bg-gray-50 text-gray-600">
                        <option value="">All Users</option>
                        @foreach (var user in Model.Users)
                        {
                            <option value="@user.Id" selected="@(Model.Filter.UserId == user.Id)">@user.DisplayName</option>
                        }
                    </select>
                    <select name="Action" class="px-3 py-2 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 bg-gray-50 text-gray-600">
                        <option value="">All Actions</option>
                        @foreach (var action in Model.Actions)
                        {
                            <option value="@action" selected="@(Model.Filter.Action == action)">@action</option>
                        }
                    </select>
                    <input name="FromDate" type="date" value="@fromDateValue" class="px-3 py-2 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 bg-gray-50 text-gray-600" />
                    <input name="ToDate" type="date" value="@toDateValue" class="px-3 py-2 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 bg-gray-50 text-gray-600" />
                    <div class="relative">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-400 absolute left-3 top-1/2 -translate-y-1/2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0" /></svg>
                        <input name="Search" type="text" value="@Model.Filter.Search" placeholder="Search logs..." class="w-full pl-9 pr-3 py-2 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 bg-gray-50 text-gray-600" />
                    </div>
                    <input type="hidden" name="PageSize" value="@Model.PageSize" />
                    <button type="submit" class="inline-flex items-center justify-center gap-2 px-4 py-2 bg-gradient-to-r from-orange-500 to-amber-500 text-white text-sm font-semibold rounded-xl hover:from-orange-600 hover:to-amber-600 shadow-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4h18M6 8h12M10 12h4m-2 4v4" /></svg>
                        Filter
                    </button>
                </form>
            </div>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="bg-amber-50 text-gray-500 text-xs font-semibold uppercase tracking-wider">
                        <th class="px-5 py-3 text-left">Timestamp</th>
                        <th class="px-5 py-3 text-left">User</th>
                        <th class="px-5 py-3 text-left">Action</th>
                        <th class="px-5 py-3 text-left">Module</th>
                        @if (Model.IsAdmin)
                        {
                            <th class="px-5 py-3 text-left">Tenant</th>
                        }
                        <th class="px-5 py-3 text-left">Store</th>
                        <th class="px-5 py-3 text-left">Entity</th>
                        <th class="px-5 py-3 text-left">Description</th>
                        <th class="px-5 py-3 text-left">IP Address</th>
                        <th class="px-5 py-3 text-left">Severity</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-50">
                    @if (Model.Logs.Count == 0)
                    {
                        <tr>
                            <td colspan="@tableColspan" class="px-5 py-10 text-center text-sm text-gray-400">No audit logs found.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model.Logs)
                        {
                            <tr class="hover:bg-orange-50/30">
                                <td class="px-5 py-3 font-mono text-xs text-gray-500 whitespace-nowrap">@DateTimeText(item.CreatedAt)</td>
                                <td class="px-5 py-3">
                                    <div class="flex items-center gap-2 min-w-44">
                                        <div class="w-7 h-7 bg-gradient-to-br from-orange-400 to-amber-400 rounded-full flex items-center justify-center text-white text-xs font-bold flex-shrink-0">@Initial(item.UserName)</div>
                                        <div class="min-w-0">
                                            <p class="text-xs font-semibold text-gray-700 truncate">@item.UserName</p>
                                            <p class="text-[11px] text-gray-400 truncate">@(item.UserEmail ?? item.UserId ?? "-")</p>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-5 py-3">
                                    <span class="@ActionBadge(item.ActionGroup) px-2.5 py-0.5 rounded-lg text-xs font-bold">@item.Action</span>
                                </td>
                                <td class="px-5 py-3">
                                    <span class="px-2.5 py-0.5 bg-orange-50 text-orange-700 rounded-lg text-xs font-semibold">@item.Module</span>
                                </td>
                                @if (Model.IsAdmin)
                                {
                                    <td class="px-5 py-3 text-xs text-gray-600">@item.TenantName</td>
                                }
                                <td class="px-5 py-3 text-xs text-gray-600 whitespace-nowrap">@StoreText(item)</td>
                                <td class="px-5 py-3">
                                    <p class="text-xs font-semibold text-gray-700">@(item.EntityName ?? "-")</p>
                                    <p class="font-mono text-[11px] text-gray-400 max-w-36 truncate">@(item.EntityId ?? "-")</p>
                                </td>
                                <td class="px-5 py-3 text-gray-600 text-sm max-w-sm">
                                    <p class="truncate" title="@item.Description">@item.Description</p>
                                    @if (!string.IsNullOrWhiteSpace(item.OldValue))
                                    {
                                        <p class="mt-1 text-[11px] text-gray-400 truncate" title="@item.OldValue">Before: @item.OldValue</p>
                                    }
                                </td>
                                <td class="px-5 py-3 font-mono text-xs text-gray-400">@(item.IpAddress ?? "-")</td>
                                <td class="px-5 py-3">
                                    <span class="@SeverityBadge(item.Severity) inline-flex rounded-full border px-2.5 py-0.5 text-xs font-semibold">@item.SeverityLabel</span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3 px-5 py-3 border-t border-gray-50 text-xs text-gray-400">
            <span>Page @Model.Page of @Model.TotalPages</span>
            <div class="flex items-center gap-1">
                @if (Model.HasPreviousPage)
                {
                    <a asp-area="@Model.AreaName" asp-controller="AuditLogs" asp-action="Index"
                       asp-route-TenantId="@Model.Filter.TenantId" asp-route-StoreId="@Model.Filter.StoreId"
                       asp-route-UserId="@Model.Filter.UserId" asp-route-Action="@Model.Filter.Action"
                       asp-route-Search="@Model.Filter.Search" asp-route-FromDate="@fromDateValue"
                       asp-route-ToDate="@toDateValue" asp-route-Page="@(Model.Page - 1)"
                       asp-route-PageSize="@Model.PageSize"
                       class="px-3 py-1.5 rounded-lg hover:bg-orange-50 text-gray-500">Prev</a>
                }
                else
                {
                    <span class="px-3 py-1.5 rounded-lg text-gray-300">Prev</span>
                }

                <span class="px-3 py-1.5 rounded-lg bg-orange-500 text-white font-semibold">@Model.Page</span>

                @if (Model.HasNextPage)
                {
                    <a asp-area="@Model.AreaName" asp-controller="AuditLogs" asp-action="Index"
                       asp-route-TenantId="@Model.Filter.TenantId" asp-route-StoreId="@Model.Filter.StoreId"
                       asp-route-UserId="@Model.Filter.UserId" asp-route-Action="@Model.Filter.Action"
                       asp-route-Search="@Model.Filter.Search" asp-route-FromDate="@fromDateValue"
                       asp-route-ToDate="@toDateValue" asp-route-Page="@(Model.Page + 1)"
                       asp-route-PageSize="@Model.PageSize"
                       class="px-3 py-1.5 rounded-lg hover:bg-orange-50 text-gray-500">Next</a>
                }
                else
                {
                    <span class="px-3 py-1.5 rounded-lg text-gray-300">Next</span>
                }
            </div>
        </div>
    </div>
</div>
