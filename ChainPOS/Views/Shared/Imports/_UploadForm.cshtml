@model ChainPOS.ViewModels.Imports.BulkImportUploadViewModel

<div class="max-w-3xl space-y-5">
    <div class="flex items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">@Model.Title</h1>
            <p class="text-sm text-gray-500 mt-1">Upload a CSV file or the first sheet of an XLSX workbook.</p>
            <p class="text-xs text-gray-400 mt-1">Partial import mode: valid rows are committed; invalid rows are reported with row-level errors.</p>
        </div>
        <a asp-area="@Model.AreaName" asp-controller="@Model.ControllerName" asp-action="@Model.TemplateAction" class="rounded-xl border border-orange-200 bg-orange-50 px-4 py-2.5 text-sm font-semibold text-orange-700 hover:bg-orange-100">Template</a>
    </div>

    <form asp-area="@Model.AreaName" asp-controller="@Model.ControllerName" asp-action="@Model.ActionName" method="post" enctype="multipart/form-data" class="bg-white rounded-2xl border border-orange-100 shadow-sm">
        @Html.AntiForgeryToken()
        <div class="p-5 space-y-4">
            <div>
                <label for="file" class="block text-xs font-semibold text-gray-600 mb-1.5">Import file</label>
                <input id="file" name="file" type="file" accept=".csv,.xlsx" class="block w-full text-sm text-gray-600 file:mr-4 file:rounded-xl file:border-0 file:bg-orange-50 file:px-4 file:py-2.5 file:text-sm file:font-semibold file:text-orange-700 hover:file:bg-orange-100" />
                <p class="mt-1 text-xs text-gray-400">Supported formats: CSV, XLSX. The first row must contain column names.</p>
                <p class="mt-1 text-xs text-gray-400">Download the template for required columns. After upload, each row shows Success or Failed with a specific message.</p>
            </div>
        </div>
        <div class="flex gap-3 rounded-b-2xl bg-gray-50 px-5 py-4">
            <a asp-area="@Model.AreaName" asp-controller="@Model.ControllerName" asp-action="@Model.BackAction" class="flex-1 py-2.5 border border-gray-200 text-gray-600 text-sm font-semibold rounded-xl hover:bg-gray-50 text-center">Cancel</a>
            <button type="submit" class="flex-1 py-2.5 bg-gradient-to-r from-orange-500 to-amber-500 text-white text-sm font-semibold rounded-xl hover:from-orange-600 hover:to-amber-600">Import</button>
        </div>
    </form>
</div>
