@using System.Text.Json
@model ChainPOS.ViewModels.Reports.ReportsIndexViewModel
@{
    string Money(decimal value) => value.ToString("#,##0.##");
    string DateText(DateOnly? value) => value?.ToString("dd/MM/yyyy") ?? "-";
    string DateTimeText(DateTime value) => value.ToLocalTime().ToString("dd/MM/yyyy HH:mm");
    string StockBadge(bool isLowStock) => isLowStock
        ? "border-amber-100 bg-amber-50 text-amber-700"
        : "border-green-100 bg-green-50 text-green-700";
    var fromDateValue = Model.Filter.FromDate?.ToString("yyyy-MM-dd") ?? string.Empty;
    var toDateValue = Model.Filter.ToDate?.ToString("yyyy-MM-dd") ?? string.Empty;
    var periodText = $"{Model.Filter.FromDate?.ToString("dd/MM")} - {Model.Filter.ToDate?.ToString("dd/MM")}";
    var financeBadge = Model.IsAdmin ? $"{Model.SystemPaymentCount} payments" : $"{Money(Model.TaxTotal)} tax";

    var salesTrend = Model.DailySales
        .Where(x => x.ReportDate.HasValue)
        .GroupBy(x => x.ReportDate!.Value)
        .OrderBy(x => x.Key)
        .Select(x => new
        {
            Date = x.Key,
            Revenue = x.Sum(i => i.TotalAmount),
            Orders = x.Sum(i => i.OrderCount)
        })
        .TakeLast(12)
        .ToArray();

    var staffMix = Model.StaffSales
        .GroupBy(x => x.StaffName)
        .Select(x => new
        {
            Staff = x.Key,
            Revenue = x.Sum(i => i.TotalSales)
        })
        .OrderByDescending(x => x.Revenue)
        .Take(5)
        .ToArray();

    var salesLabelsJson = JsonSerializer.Serialize(salesTrend.Select(x => x.Date.ToString("dd/MM")));
    var salesRevenueJson = JsonSerializer.Serialize(salesTrend.Select(x => x.Revenue));
    var salesOrdersJson = JsonSerializer.Serialize(salesTrend.Select(x => x.Orders));
    var staffLabelsJson = JsonSerializer.Serialize(staffMix.Select(x => x.Staff));
    var staffRevenueJson = JsonSerializer.Serialize(staffMix.Select(x => x.Revenue));
}

<div class="flex flex-col gap-5">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 text-sm text-gray-400 mb-0.5">
                <a asp-area="@Model.AreaName" asp-controller="Dashboard" asp-action="Index" class="hover:text-orange-500">Dashboard</a>
                <span>/</span><span class="text-gray-600 font-medium">Analytics</span>
                <span>/</span><span class="text-orange-500 font-medium">Reports</span>
            </div>
            <h1 class="text-2xl font-bold text-gray-900">Business Reports</h1>
            <p class="text-sm text-gray-500 mt-1">Sales, staff performance, inventory status and platform revenue from reporting views.</p>
        </div>
        <div class="flex items-center gap-2 bg-gray-50 border border-gray-200 rounded-xl p-1">
            <span class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-orange-500 text-white shadow-sm">@periodText</span>
            <a asp-area="@Model.AreaName" asp-controller="Reports" asp-action="Index" class="px-3 py-1.5 rounded-lg text-xs font-semibold text-gray-500 hover:bg-white">Reset</a>
        </div>
    </div>

    <div class="bg-white rounded-2xl border border-orange-100 shadow-sm p-4">
        <form asp-area="@Model.AreaName" asp-controller="Reports" asp-action="Index" method="get" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-5 gap-3">
            @if (Model.IsAdmin)
            {
                <select name="TenantId" class="px-3 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 bg-gray-50 text-gray-600">
                    <option value="">All Tenants</option>
                    @foreach (var tenant in Model.Tenants)
                    {
                        <option value="@tenant.Id" selected="@(Model.Filter.TenantId == tenant.Id)">@tenant.Name</option>
                    }
                </select>
            }
            <select name="StoreId" class="px-3 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 bg-gray-50 text-gray-600">
                <option value="">All Stores</option>
                @foreach (var store in Model.Stores)
                {
                    <option value="@store.Id" selected="@(Model.Filter.StoreId == store.Id)">@store.Name (@store.Code)</option>
                }
            </select>
            <input name="FromDate" type="date" value="@fromDateValue" class="px-3 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 bg-gray-50 text-gray-600" />
            <input name="ToDate" type="date" value="@toDateValue" class="px-3 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 bg-gray-50 text-gray-600" />
            <button type="submit" class="inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-gradient-to-r from-orange-500 to-amber-500 text-white text-sm font-semibold rounded-xl hover:from-orange-600 hover:to-amber-600 shadow-sm">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4h18M6 8h12M10 12h4m-2 4v4" /></svg>
                Filter Reports
            </button>
        </form>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white rounded-2xl p-5 border border-orange-100 shadow-sm">
            <div class="flex items-center justify-between mb-3">
                <div class="w-10 h-10 bg-orange-100 rounded-xl flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-orange-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" /></svg>
                </div>
                <span class="text-xs font-semibold text-orange-600 bg-orange-50 px-2 py-0.5 rounded-full">@Model.SalesOrderCount orders</span>
            </div>
            <p class="text-2xl font-bold text-gray-900">@Money(Model.SalesRevenue)</p>
            <p class="text-xs text-gray-500 mt-0.5">Sales revenue</p>
            <div class="mt-3 w-full bg-gray-100 rounded-full h-1.5"><div class="bg-orange-500 h-1.5 rounded-full" style="width:72%"></div></div>
        </div>
        <div class="bg-white rounded-2xl p-5 border border-orange-100 shadow-sm">
            <div class="flex items-center justify-between mb-3">
                <div class="w-10 h-10 bg-amber-100 rounded-xl flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M15 7a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                </div>
                <span class="text-xs font-semibold text-amber-600 bg-amber-50 px-2 py-0.5 rounded-full">@Model.StaffOrderCount orders</span>
            </div>
            <p class="text-2xl font-bold text-gray-900">@Money(Model.StaffSalesTotal)</p>
            <p class="text-xs text-gray-500 mt-0.5">Staff sales</p>
            <div class="mt-3 w-full bg-gray-100 rounded-full h-1.5"><div class="bg-amber-400 h-1.5 rounded-full" style="width:58%"></div></div>
        </div>
        <div class="bg-white rounded-2xl p-5 border border-orange-100 shadow-sm">
            <div class="flex items-center justify-between mb-3">
                <div class="w-10 h-10 bg-emerald-100 rounded-xl flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10" /></svg>
                </div>
                <span class="text-xs font-semibold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-full">@Model.LowStockItemCount low</span>
            </div>
            <p class="text-2xl font-bold text-gray-900">@Model.InventoryItemCount</p>
            <p class="text-xs text-gray-500 mt-0.5">Inventory records</p>
            <div class="mt-3 w-full bg-gray-100 rounded-full h-1.5"><div class="bg-emerald-500 h-1.5 rounded-full" style="width:46%"></div></div>
        </div>
        <div class="bg-white rounded-2xl p-5 border border-orange-100 shadow-sm">
            <div class="flex items-center justify-between mb-3">
                <div class="w-10 h-10 bg-yellow-100 rounded-xl flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-yellow-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8V7m0 9v1m9-5a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                </div>
                <span class="text-xs font-semibold text-yellow-700 bg-yellow-50 px-2 py-0.5 rounded-full">@financeBadge</span>
            </div>
            <p class="text-2xl font-bold text-gray-900">@(Model.IsAdmin ? Money(Model.SystemRevenueTotal) : Money(Model.TaxTotal))</p>
            <p class="text-xs text-gray-500 mt-0.5">@(Model.IsAdmin ? "System revenue" : "Tax amount")</p>
            <div class="mt-3 w-full bg-gray-100 rounded-full h-1.5"><div class="bg-yellow-400 h-1.5 rounded-full" style="width:38%"></div></div>
        </div>
    </div>

    <div class="grid grid-cols-1 xl:grid-cols-3 gap-5">
        <div class="xl:col-span-2 bg-white rounded-2xl p-5 border border-orange-100 shadow-sm">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3 mb-5">
                <div>
                    <h3 class="font-bold text-gray-900">Sales Trend</h3>
                    <p class="text-xs text-gray-400 mt-0.5">Revenue and order volume by report date</p>
                </div>
                <div class="flex items-center gap-4 text-xs font-medium">
                    <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-orange-500 inline-block"></span>Revenue</span>
                    <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-amber-400 inline-block"></span>Orders</span>
                </div>
            </div>
            <div class="h-64"><canvas id="reportSalesChart"></canvas></div>
        </div>
        <div class="bg-white rounded-2xl p-5 border border-orange-100 shadow-sm">
            <div class="mb-4">
                <h3 class="font-bold text-gray-900">Staff Mix</h3>
                <p class="text-xs text-gray-400 mt-0.5">Top staff by sales amount</p>
            </div>
            <div class="h-48"><canvas id="reportStaffChart"></canvas></div>
            <div class="mt-4 space-y-2">
                @if (staffMix.Length == 0)
                {
                    <p class="text-sm text-gray-400">No staff sales in this period.</p>
                }
                else
                {
                    foreach (var staff in staffMix)
                    {
                        <div class="flex items-center justify-between text-xs">
                            <span class="flex items-center gap-2"><span class="w-2.5 h-2.5 rounded-sm bg-orange-500 inline-block"></span><span class="text-gray-600">@staff.Staff</span></span>
                            <span class="font-bold text-gray-800">@Money(staff.Revenue)</span>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <div class="bg-white rounded-2xl border border-orange-100 shadow-sm overflow-hidden">
        <div class="px-5 py-4 border-b border-gray-50 flex items-center justify-between">
            <div>
                <h3 class="font-bold text-gray-900">Daily Sales Report</h3>
                <p class="text-xs text-gray-400 mt-0.5">Using VwDailySalesReports</p>
            </div>
            <span class="text-xs text-gray-400">@Model.DailySales.Count record(s)</span>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="bg-amber-50 text-gray-500 text-xs font-semibold uppercase">
                        <th class="px-5 py-3 text-left">Date</th>
                        @if (Model.IsAdmin)
                        {
                            <th class="px-5 py-3 text-left">Tenant</th>
                        }
                        <th class="px-5 py-3 text-left">Store</th>
                        <th class="px-5 py-3 text-center">Orders</th>
                        <th class="px-5 py-3 text-right">Subtotal</th>
                        <th class="px-5 py-3 text-right">Discount</th>
                        <th class="px-5 py-3 text-right">Tax</th>
                        <th class="px-5 py-3 text-right">Total</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-50">
                    @if (Model.DailySales.Count == 0)
                    {
                        <tr><td colspan="@(Model.IsAdmin ? 8 : 7)" class="px-5 py-10 text-center text-sm text-gray-400">No daily sales found.</td></tr>
                    }
                    else
                    {
                        foreach (var item in Model.DailySales)
                        {
                            <tr class="hover:bg-orange-50/30">
                                <td class="px-5 py-3 font-medium text-gray-800">@DateText(item.ReportDate)</td>
                                @if (Model.IsAdmin)
                                {
                                    <td class="px-5 py-3 text-gray-600">@item.TenantName</td>
                                }
                                <td class="px-5 py-3"><p class="font-semibold text-gray-800">@item.StoreName</p><p class="font-mono text-xs text-gray-400">@item.StoreCode</p></td>
                                <td class="px-5 py-3 text-center font-bold text-gray-900">@item.OrderCount</td>
                                <td class="px-5 py-3 text-right text-gray-700">@Money(item.SubTotal)</td>
                                <td class="px-5 py-3 text-right text-red-400">@Money(item.DiscountAmount)</td>
                                <td class="px-5 py-3 text-right text-amber-600">@Money(item.TaxAmount)</td>
                                <td class="px-5 py-3 text-right font-bold text-emerald-600">@Money(item.TotalAmount)</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="grid grid-cols-1 xl:grid-cols-2 gap-5">
        <div class="bg-white rounded-2xl border border-orange-100 shadow-sm overflow-hidden">
            <div class="px-5 py-4 border-b border-gray-50 flex items-center justify-between">
                <div>
                    <h3 class="font-bold text-gray-900">Staff Sales Report</h3>
                    <p class="text-xs text-gray-400 mt-0.5">Using VwStaffSalesReports</p>
                </div>
                <span class="text-xs text-gray-400">@Model.StaffSales.Count record(s)</span>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="bg-amber-50 text-gray-500 text-xs font-semibold uppercase">
                            <th class="px-5 py-3 text-left">Staff</th>
                            <th class="px-5 py-3 text-left">Store</th>
                            <th class="px-5 py-3 text-left">Date</th>
                            <th class="px-5 py-3 text-center">Orders</th>
                            <th class="px-5 py-3 text-right">Sales</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-50">
                        @if (Model.StaffSales.Count == 0)
                        {
                            <tr><td colspan="5" class="px-5 py-10 text-center text-sm text-gray-400">No staff sales found.</td></tr>
                        }
                        else
                        {
                            foreach (var item in Model.StaffSales)
                            {
                                <tr class="hover:bg-orange-50/30">
                                    <td class="px-5 py-3 font-semibold text-gray-800">@item.StaffName</td>
                                    <td class="px-5 py-3"><p class="font-semibold text-gray-800">@item.StoreName</p><p class="font-mono text-xs text-gray-400">@item.StoreCode</p></td>
                                    <td class="px-5 py-3 text-gray-500">@DateText(item.ReportDate)</td>
                                    <td class="px-5 py-3 text-center font-bold text-gray-900">@item.OrderCount</td>
                                    <td class="px-5 py-3 text-right font-bold text-emerald-600">@Money(item.TotalSales)</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="bg-white rounded-2xl border border-orange-100 shadow-sm overflow-hidden">
            <div class="px-5 py-4 border-b border-gray-50 flex items-center justify-between">
                <div>
                    <h3 class="font-bold text-gray-900">Inventory Status Report</h3>
                    <p class="text-xs text-gray-400 mt-0.5">Using VwInventoryStatusReports</p>
                </div>
                <span class="text-xs text-gray-400">@Model.InventoryStatus.Count record(s)</span>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="bg-amber-50 text-gray-500 text-xs font-semibold uppercase">
                            <th class="px-5 py-3 text-left">Product</th>
                            <th class="px-5 py-3 text-left">Store</th>
                            <th class="px-5 py-3 text-center">Qty</th>
                            <th class="px-5 py-3 text-center">Min</th>
                            <th class="px-5 py-3 text-left">Status</th>
                            <th class="px-5 py-3 text-left">Updated</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-50">
                        @if (Model.InventoryStatus.Count == 0)
                        {
                            <tr><td colspan="6" class="px-5 py-10 text-center text-sm text-gray-400">No inventory status found.</td></tr>
                        }
                        else
                        {
                            foreach (var item in Model.InventoryStatus)
                            {
                                <tr class="hover:bg-orange-50/30">
                                    <td class="px-5 py-3"><p class="font-semibold text-gray-800">@item.ProductName</p><p class="font-mono text-xs text-gray-400">@(item.Sku ?? item.Barcode ?? "-")</p></td>
                                    <td class="px-5 py-3"><p class="font-semibold text-gray-800">@item.StoreName</p><p class="font-mono text-xs text-gray-400">@item.StoreCode</p></td>
                                    <td class="px-5 py-3 text-center font-bold text-gray-900">@item.Quantity.ToString("#,##0.###")</td>
                                    <td class="px-5 py-3 text-center text-gray-500">@item.MinQuantity.ToString("#,##0.###")</td>
                                    <td class="px-5 py-3"><span class="inline-flex rounded-full border px-2.5 py-0.5 text-xs font-semibold @StockBadge(item.IsLowStock)">@(item.IsLowStock ? "Low Stock" : "In Stock")</span></td>
                                    <td class="px-5 py-3 text-xs text-gray-400">@DateTimeText(item.UpdatedAt)</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @if (Model.IsAdmin)
    {
        <div class="bg-white rounded-2xl border border-orange-100 shadow-sm overflow-hidden">
            <div class="px-5 py-4 border-b border-gray-50 flex items-center justify-between">
                <div>
                    <h3 class="font-bold text-gray-900">System Revenue Report</h3>
                    <p class="text-xs text-gray-400 mt-0.5">Using VwSystemRevenueReports</p>
                </div>
                <span class="text-xs text-gray-400">@Model.SystemRevenue.Count record(s)</span>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="bg-amber-50 text-gray-500 text-xs font-semibold uppercase">
                            <th class="px-5 py-3 text-left">Paid Date</th>
                            <th class="px-5 py-3 text-left">Tenant</th>
                            <th class="px-5 py-3 text-center">Payments</th>
                            <th class="px-5 py-3 text-right">Amount</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-50">
                        @if (Model.SystemRevenue.Count == 0)
                        {
                            <tr><td colspan="4" class="px-5 py-10 text-center text-sm text-gray-400">No system revenue found.</td></tr>
                        }
                        else
                        {
                            foreach (var item in Model.SystemRevenue)
                            {
                                <tr class="hover:bg-orange-50/30">
                                    <td class="px-5 py-3 font-medium text-gray-800">@DateText(item.PaidDate)</td>
                                    <td class="px-5 py-3 text-gray-600">@item.TenantName</td>
                                    <td class="px-5 py-3 text-center font-bold text-gray-900">@item.PaymentCount</td>
                                    <td class="px-5 py-3 text-right font-bold text-emerald-600">@Money(item.TotalAmount)</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<script>
    (() => {
        const salesCanvas = document.getElementById('reportSalesChart');
        if (salesCanvas) {
            new Chart(salesCanvas.getContext('2d'), {
                type: 'line',
                data: {
                    labels: @Html.Raw(salesLabelsJson),
                    datasets: [
                        {
                            label: 'Revenue',
                            data: @Html.Raw(salesRevenueJson),
                            borderColor: '#f97316',
                            backgroundColor: 'rgba(249,115,22,0.08)',
                            borderWidth: 2.5,
                            fill: true,
                            tension: 0.4,
                            pointBackgroundColor: '#f97316',
                            pointRadius: 4
                        },
                        {
                            label: 'Orders',
                            data: @Html.Raw(salesOrdersJson),
                            borderColor: '#fbbf24',
                            backgroundColor: 'rgba(251,191,36,0.08)',
                            borderWidth: 2,
                            fill: false,
                            tension: 0.4,
                            yAxisID: 'orders'
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        x: { grid: { display: false }, ticks: { font: { size: 11 } } },
                        y: {
                            grid: { color: 'rgba(0,0,0,0.04)' },
                            beginAtZero: true,
                            ticks: { font: { size: 11 } }
                        },
                        orders: {
                            position: 'right',
                            beginAtZero: true,
                            grid: { drawOnChartArea: false },
                            ticks: { font: { size: 11 }, precision: 0 }
                        }
                    }
                }
            });
        }

        const staffCanvas = document.getElementById('reportStaffChart');
        if (staffCanvas) {
            new Chart(staffCanvas.getContext('2d'), {
                type: 'doughnut',
                data: {
                    labels: @Html.Raw(staffLabelsJson),
                    datasets: [{
                        data: @Html.Raw(staffRevenueJson),
                        backgroundColor: ['#f97316', '#fbbf24', '#fde047', '#fed7aa', '#10b981'],
                        borderWidth: 0,
                        hoverOffset: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    cutout: '68%'
                }
            });
        }
    })();
</script>
