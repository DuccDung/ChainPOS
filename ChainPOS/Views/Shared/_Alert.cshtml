@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="mb-5 rounded-xl border border-green-200 bg-green-50 px-4 py-3 text-sm font-medium text-green-700">@successMessage</div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="mb-5 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-700">@errorMessage</div>
}
