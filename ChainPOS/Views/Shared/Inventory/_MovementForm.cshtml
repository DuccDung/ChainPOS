@model ChainPOS.ViewModels.Inventory.InventoryMovementViewModel
@{
    var movement = ViewData["Movement"]?.ToString() ?? "Import";
    var isImport = string.Equals(movement, "Import", StringComparison.OrdinalIgnoreCase);
}

<div class="max-w-4xl space-y-5">
    <div class="flex items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 text-sm text-gray-400 mb-0.5">
                <a asp-area="@Model.AreaName" asp-controller="Inventory" asp-action="Index" asp-route-storeId="@Model.StoreId" class="hover:text-orange-500">Inventory</a>
                <span>/</span><span class="text-orange-500 font-medium">@movement Stock</span>
            </div>
            <h1 class="text-2xl font-bold text-gray-900">@movement Stock</h1>
        </div>
        <a asp-area="@Model.AreaName" asp-controller="Inventory" asp-action="Index" asp-route-storeId="@Model.StoreId" class="rounded-xl border border-gray-200 px-4 py-2.5 text-sm font-semibold text-gray-600 hover:border-orange-200 hover:text-orange-600">Back</a>
    </div>

    <form asp-area="@Model.AreaName" asp-controller="Inventory" asp-action="@movement" method="post" class="bg-white rounded-2xl border border-orange-100 shadow-sm">
        @Html.AntiForgeryToken()
        <input asp-for="AreaName" type="hidden" />
        <div class="p-5 space-y-4">
            <div asp-validation-summary="ModelOnly" class="text-sm text-red-600"></div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label asp-for="StoreId" class="block text-xs font-semibold text-gray-600 mb-1.5"></label>
                    <select asp-for="StoreId" class="w-full px-3.5 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 bg-white">
                        <option value="">Choose store</option>
                        @foreach (var store in Model.Stores)
                        {
                            <option value="@store.Id">@store.Name (@store.Code)</option>
                        }
                    </select>
                    <span asp-validation-for="StoreId" class="text-xs text-red-600"></span>
                </div>
                <div>
                    <label asp-for="ProductId" class="block text-xs font-semibold text-gray-600 mb-1.5"></label>
                    <select asp-for="ProductId" class="w-full px-3.5 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 bg-white">
                        <option value="">Choose product</option>
                        @foreach (var product in Model.Products)
                        {
                            <option value="@product.Id">@product.Name (@(product.Sku ?? "No SKU"))</option>
                        }
                    </select>
                    <span asp-validation-for="ProductId" class="text-xs text-red-600"></span>
                </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label asp-for="Quantity" class="block text-xs font-semibold text-gray-600 mb-1.5"></label>
                    <input asp-for="Quantity" type="number" step="0.001" min="0.001" class="w-full px-3.5 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 bg-white" />
                    <span asp-validation-for="Quantity" class="text-xs text-red-600"></span>
                </div>
                @if (isImport)
                {
                    <div>
                        <label asp-for="MinQuantity" class="block text-xs font-semibold text-gray-600 mb-1.5"></label>
                        <input asp-for="MinQuantity" type="number" step="0.001" min="0" class="w-full px-3.5 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 bg-white" />
                        <span asp-validation-for="MinQuantity" class="text-xs text-red-600"></span>
                    </div>
                }
                else
                {
                    <input asp-for="MinQuantity" type="hidden" />
                }
            </div>
            <div>
                <label asp-for="Reason" class="block text-xs font-semibold text-gray-600 mb-1.5"></label>
                <textarea asp-for="Reason" rows="3" placeholder="Optional note..." class="w-full px-3.5 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 bg-white"></textarea>
                <span asp-validation-for="Reason" class="text-xs text-red-600"></span>
            </div>
        </div>
        <div class="flex gap-3 rounded-b-2xl bg-gray-50 px-5 py-4">
            <a asp-area="@Model.AreaName" asp-controller="Inventory" asp-action="Index" asp-route-storeId="@Model.StoreId" class="flex-1 py-2.5 border border-gray-200 text-gray-600 text-sm font-semibold rounded-xl hover:bg-gray-50 text-center">Cancel</a>
            <button type="submit" class="flex-1 py-2.5 bg-gradient-to-r from-orange-500 to-amber-500 text-white text-sm font-semibold rounded-xl hover:from-orange-600 hover:to-amber-600">@movement Stock</button>
        </div>
    </form>
</div>
