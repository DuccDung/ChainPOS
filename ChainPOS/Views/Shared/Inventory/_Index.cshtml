@model ChainPOS.ViewModels.Inventory.InventoryIndexViewModel
@{
    string StatusClass(ChainPOS.ViewModels.Inventory.InventoryListItemViewModel item)
        => item.Quantity <= 0
            ? "border-red-100 bg-red-50 text-red-700"
            : item.IsLowStock
                ? "border-amber-100 bg-amber-50 text-amber-700"
                : "border-green-100 bg-green-50 text-green-700";

    string StatusText(ChainPOS.ViewModels.Inventory.InventoryListItemViewModel item)
        => item.Quantity <= 0 ? "Out of Stock" : item.IsLowStock ? "Low Stock" : "In Stock";
}

<div class="flex flex-col gap-5" data-live-page="inventory" data-live-store-id="@(Model.StoreId?.ToString() ?? "")">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 text-sm text-gray-400 mb-0.5">
                <a asp-area="@Model.AreaName" asp-controller="Dashboard" asp-action="Index" class="hover:text-orange-500">Dashboard</a>
                <span>/</span><span class="text-gray-600 font-medium">Inventory</span>
                <span>/</span><span class="text-orange-500 font-medium">Stock</span>
            </div>
            <h1 class="text-2xl font-bold text-gray-900">Stock Management</h1>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <a asp-area="@Model.AreaName" asp-controller="Inventory" asp-action="Import" asp-route-storeId="@Model.StoreId" class="inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-gradient-to-r from-orange-500 to-amber-500 text-white text-sm font-semibold rounded-xl hover:from-orange-600 hover:to-amber-600 transition-all shadow-sm">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
                Import Stock
            </a>
            <a asp-area="@Model.AreaName" asp-controller="Inventory" asp-action="Export" asp-route-storeId="@Model.StoreId" class="rounded-xl border border-orange-200 bg-orange-50 px-4 py-2.5 text-sm font-semibold text-orange-700 hover:bg-orange-100">Export</a>
            <a asp-area="@Model.AreaName" asp-controller="Inventory" asp-action="Adjust" asp-route-storeId="@Model.StoreId" class="rounded-xl border border-gray-200 px-4 py-2.5 text-sm font-semibold text-gray-600 hover:border-orange-200 hover:text-orange-600">Adjust</a>
        </div>
    </div>

    @if (Model.LowStockItems > 0 || Model.OutOfStockItems > 0)
    {
        <div class="bg-amber-50 border border-amber-300 rounded-2xl p-4 flex items-start gap-3">
            <div class="w-8 h-8 bg-amber-100 rounded-xl flex items-center justify-center flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
            </div>
            <div>
                <p class="font-semibold text-amber-800 text-sm">@Model.LowStockItems low stock item(s), @Model.OutOfStockItems out of stock item(s)</p>
                <p class="text-xs text-amber-600 mt-0.5">Filter by stock status to review items that need attention.</p>
            </div>
        </div>
    }

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white rounded-2xl p-4 border border-orange-100 shadow-sm"><p class="text-xs text-gray-400 mb-2">Inventory Items</p><p class="text-2xl font-bold text-gray-900">@Model.TotalItems</p><p class="text-xs text-gray-400 mt-1">@Model.Stores.Count accessible store(s)</p></div>
        <div class="bg-white rounded-2xl p-4 border border-orange-100 shadow-sm"><p class="text-xs text-gray-400 mb-2">Low Stock</p><p class="text-2xl font-bold text-amber-500">@Model.LowStockItems</p><p class="text-xs text-amber-600 font-medium mt-1">Needs restocking</p></div>
        <div class="bg-white rounded-2xl p-4 border border-orange-100 shadow-sm"><p class="text-xs text-gray-400 mb-2">Out of Stock</p><p class="text-2xl font-bold text-red-500">@Model.OutOfStockItems</p><p class="text-xs text-red-500 font-medium mt-1">Urgent reorder</p></div>
        <div class="bg-white rounded-2xl p-4 border border-orange-100 shadow-sm"><p class="text-xs text-gray-400 mb-2">Total Quantity</p><p class="text-2xl font-bold text-gray-900">@Model.TotalQuantity.ToString("#,##0.###")</p><p class="text-xs text-gray-400 mt-1">Across visible stock</p></div>
    </div>

    <div class="bg-white rounded-2xl border border-orange-100 shadow-sm overflow-hidden">
        <div class="flex flex-col md:flex-row md:items-center justify-between px-5 py-4 gap-3 border-b border-gray-50">
            <div>
                <h3 class="font-bold text-gray-900">Product Inventory</h3>
                <p class="text-xs text-gray-400 mt-0.5">Showing @Model.Items.Count record(s)</p>
            </div>
            <form asp-area="@Model.AreaName" asp-controller="Inventory" asp-action="Index" method="get" class="flex items-center gap-2 flex-wrap">
                <div class="relative">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-400 absolute left-3 top-1/2 -translate-y-1/2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0" /></svg>
                    <input asp-for="Search" placeholder="Search products..." class="pl-9 pr-4 py-2 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 bg-gray-50 w-52" />
                </div>
                <select asp-for="StoreId" class="px-3 py-2 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 bg-gray-50 text-gray-600">
                    <option value="">All Stores</option>
                    @foreach (var store in Model.Stores)
                    {
                        <option value="@store.Id">@store.Name (@store.Code)</option>
                    }
                </select>
                <select asp-for="StockStatus" class="px-3 py-2 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 bg-gray-50 text-gray-600">
                    <option value="">All Stock</option>
                    <option value="ok">In Stock</option>
                    <option value="low">Low Stock</option>
                    <option value="out">Out of Stock</option>
                </select>
                <button type="submit" class="px-4 py-2 bg-orange-500 text-white text-sm font-semibold rounded-xl hover:bg-orange-600">Filter</button>
            </form>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full data-table text-sm">
                <thead>
                    <tr class="bg-amber-50 text-gray-500 text-xs font-semibold uppercase tracking-wider">
                        <th class="px-5 py-3 text-left">Product</th>
                        <th class="px-5 py-3 text-left">SKU</th>
                        <th class="px-5 py-3 text-left">Store</th>
                        <th class="px-5 py-3 text-left">Category</th>
                        <th class="px-5 py-3 text-center">Quantity</th>
                        <th class="px-5 py-3 text-center">Min Stock</th>
                        <th class="px-5 py-3 text-left">Status</th>
                        <th class="px-5 py-3 text-left">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-50">
                    @if (Model.Items.Count == 0)
                    {
                        <tr><td colspan="8" class="px-5 py-10 text-center text-sm text-gray-400">No inventory found.</td></tr>
                    }
                    else
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr class="hover:bg-orange-50/30" data-realtime-inventory-row data-store-id="@item.StoreId" data-product-id="@item.ProductId" data-min-quantity="@item.MinQuantity">
                                <td class="px-5 py-3.5 font-semibold text-gray-800">@item.ProductName</td>
                                <td class="px-5 py-3.5 font-mono text-xs text-gray-500">@(item.Sku ?? "-")</td>
                                <td class="px-5 py-3.5">
                                    <p class="font-semibold text-gray-800 text-sm">@item.StoreName</p>
                                    <p class="font-mono text-xs text-gray-400">@item.StoreCode</p>
                                </td>
                                <td class="px-5 py-3.5"><span class="px-2.5 py-1 bg-orange-50 text-orange-700 rounded-lg text-xs font-semibold">@(item.CategoryName ?? "Uncategorized")</span></td>
                                <td class="px-5 py-3.5 text-center font-bold text-gray-900" data-realtime-quantity>@item.Quantity.ToString("#,##0.###")</td>
                                <td class="px-5 py-3.5 text-center text-gray-500" data-realtime-min-quantity>@item.MinQuantity.ToString("#,##0.###")</td>
                                <td class="px-5 py-3.5"><span data-realtime-stock-status class="inline-flex rounded-full border px-2.5 py-0.5 text-xs font-semibold @StatusClass(item)">@StatusText(item)</span></td>
                                <td class="px-5 py-3.5">
                                    <div class="flex items-center gap-1">
                                        <a asp-area="@Model.AreaName" asp-controller="Inventory" asp-action="Import" asp-route-storeId="@item.StoreId" asp-route-productId="@item.ProductId" class="px-2.5 py-1 bg-orange-50 text-orange-600 text-xs font-semibold rounded-lg hover:bg-orange-100">+ Import</a>
                                        <a asp-area="@Model.AreaName" asp-controller="Inventory" asp-action="Export" asp-route-storeId="@item.StoreId" asp-route-productId="@item.ProductId" class="px-2.5 py-1 bg-gray-50 text-gray-600 text-xs font-semibold rounded-lg hover:bg-gray-100">Export</a>
                                        <a asp-area="@Model.AreaName" asp-controller="Inventory" asp-action="Adjust" asp-route-storeId="@item.StoreId" asp-route-productId="@item.ProductId" class="px-2.5 py-1 bg-amber-50 text-amber-700 text-xs font-semibold rounded-lg hover:bg-amber-100">Adjust</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <div class="flex items-center justify-between px-5 py-3 border-t border-gray-50 text-xs text-gray-400">
            <span>Showing @Model.Items.Count of @Model.TotalItems inventory items</span>
            <div class="flex items-center gap-1">
                <button class="px-3 py-1.5 rounded-lg text-gray-300" type="button" disabled>Prev</button>
                <button class="px-3 py-1.5 rounded-lg bg-orange-500 text-white font-semibold" type="button">1</button>
                <button class="px-3 py-1.5 rounded-lg text-gray-300" type="button" disabled>Next</button>
            </div>
        </div>
    </div>
</div>
