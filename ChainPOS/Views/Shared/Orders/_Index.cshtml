@using ChainPOS.Constants
@model ChainPOS.ViewModels.Sales.OrderIndexViewModel
@{
    string OrderBadge(string status) => status == OrderStatuses.Cancelled
        ? "badge-cancelled px-2.5 py-0.5 rounded-full text-xs font-semibold"
        : status == OrderStatuses.Completed
            ? "badge-delivered px-2.5 py-0.5 rounded-full text-xs font-semibold"
            : "badge-pending px-2.5 py-0.5 rounded-full text-xs font-semibold";

    string PaymentBadge(string status) => status == OrderPaymentStatuses.Paid
        ? "badge-delivered px-2.5 py-0.5 rounded-full text-xs font-semibold"
        : status == OrderPaymentStatuses.Cancelled
            ? "badge-cancelled px-2.5 py-0.5 rounded-full text-xs font-semibold"
            : "badge-pending px-2.5 py-0.5 rounded-full text-xs font-semibold";
}

<div class="flex flex-col gap-5" data-live-page="orders" data-live-store-id="@(Model.StoreId?.ToString() ?? "")">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 text-sm text-gray-400 mb-0.5">
                <a asp-area="@Model.AreaName" asp-controller="Dashboard" asp-action="Index" class="hover:text-orange-500">Dashboard</a>
                <span>/</span><span class="text-gray-600 font-medium">Sales</span>
                <span>/</span><span class="text-orange-500 font-medium">Orders</span>
            </div>
            <h1 class="text-2xl font-bold text-gray-900">Sales Orders</h1>
        </div>
        <a asp-area="@Model.AreaName" asp-controller="Pos" asp-action="Index" asp-route-storeId="@Model.StoreId" class="inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-gradient-to-r from-orange-500 to-amber-500 text-white text-sm font-semibold rounded-xl hover:from-orange-600 hover:to-amber-600 transition-all shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
            New Order
        </a>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white rounded-2xl p-4 border border-orange-100 shadow-sm"><p class="text-xs text-gray-400 mb-2">All Orders</p><p class="text-2xl font-bold text-gray-900">@Model.TotalOrders</p><p class="text-xs text-gray-400 mt-1">@Model.Stores.Count accessible store(s)</p></div>
        <div class="bg-white rounded-2xl p-4 border border-orange-100 shadow-sm"><p class="text-xs text-green-600 font-semibold mb-2">Completed</p><p class="text-2xl font-bold text-green-600">@Model.CompletedOrders</p><p class="text-xs text-gray-400 mt-1">Paid checkout</p></div>
        <div class="bg-white rounded-2xl p-4 border border-orange-100 shadow-sm"><p class="text-xs text-red-500 font-semibold mb-2">Cancelled</p><p class="text-2xl font-bold text-red-500">@Model.CancelledOrders</p><p class="text-xs text-gray-400 mt-1">Voided orders</p></div>
        <div class="bg-white rounded-2xl p-4 border border-orange-100 shadow-sm"><p class="text-xs text-gray-400 mb-2">Revenue</p><p class="text-2xl font-bold text-gray-900">@Model.RevenueTotal.ToString("#,##0.##")</p><p class="text-xs text-gray-400 mt-1">Non-cancelled</p></div>
    </div>

    <div class="bg-white rounded-2xl border border-orange-100 shadow-sm overflow-hidden">
        <div class="flex flex-col md:flex-row md:items-center justify-between px-5 py-4 gap-3 border-b border-gray-50">
            <div>
                <h3 class="font-bold text-gray-900">Order List</h3>
                <p class="text-xs text-gray-400 mt-0.5">Showing @Model.Orders.Count record(s)</p>
            </div>
            <form asp-area="@Model.AreaName" asp-controller="Orders" asp-action="Index" method="get" class="flex items-center gap-2 flex-wrap">
                <div class="relative">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-400 absolute left-3 top-1/2 -translate-y-1/2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0" /></svg>
                    <input asp-for="Search" placeholder="Search orders..." class="pl-9 pr-4 py-2 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 bg-gray-50 w-48" />
                </div>
                <select asp-for="StoreId" class="px-3 py-2 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 bg-gray-50 text-gray-600">
                    <option value="">All Stores</option>
                    @foreach (var store in Model.Stores)
                    {
                        <option value="@store.Id">@store.Name (@store.Code)</option>
                    }
                </select>
                <select asp-for="Status" class="px-3 py-2 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 bg-gray-50 text-gray-600">
                    <option value="">All Order Status</option>
                    <option value="@OrderStatuses.Completed">Completed</option>
                    <option value="@OrderStatuses.Cancelled">Cancelled</option>
                    <option value="@OrderStatuses.New">New</option>
                </select>
                <select asp-for="PaymentStatus" class="px-3 py-2 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 bg-gray-50 text-gray-600">
                    <option value="">All Payment</option>
                    <option value="@OrderPaymentStatuses.Paid">Paid</option>
                    <option value="@OrderPaymentStatuses.Unpaid">Unpaid</option>
                    <option value="@OrderPaymentStatuses.Cancelled">Cancelled</option>
                </select>
                <input asp-for="Date" type="date" class="px-3 py-2 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 bg-gray-50 text-gray-600" />
                <button type="submit" class="px-4 py-2 bg-orange-500 text-white text-sm font-semibold rounded-xl hover:bg-orange-600">Filter</button>
            </form>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full data-table text-sm">
                <thead>
                    <tr class="bg-amber-50 text-gray-500 text-xs font-semibold uppercase tracking-wider">
                        <th class="px-5 py-3 text-left">Order</th>
                        <th class="px-5 py-3 text-left">Store</th>
                        <th class="px-5 py-3 text-left">Staff</th>
                        <th class="px-5 py-3 text-center">Items</th>
                        <th class="px-5 py-3 text-right">Amount</th>
                        <th class="px-5 py-3 text-left">Payment</th>
                        <th class="px-5 py-3 text-left">Status</th>
                        <th class="px-5 py-3 text-left">Date</th>
                        <th class="px-5 py-3 text-left">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-50">
                    @if (Model.Orders.Count == 0)
                    {
                        <tr><td colspan="9" class="px-5 py-10 text-center text-sm text-gray-400">No orders found.</td></tr>
                    }
                    else
                    {
                        foreach (var order in Model.Orders)
                        {
                            <tr class="hover:bg-orange-50/30" data-realtime-order-row data-order-id="@order.Id" data-store-id="@Model.StoreId">
                                <td class="px-5 py-3.5 font-mono text-sm text-orange-500 font-semibold">@order.OrderCode</td>
                                <td class="px-5 py-3.5"><p class="font-semibold text-gray-800">@order.StoreName</p><p class="font-mono text-xs text-gray-400">@order.StoreCode</p></td>
                                <td class="px-5 py-3.5 text-gray-600">@(order.StaffName ?? "-")</td>
                                <td class="px-5 py-3.5 text-center font-bold text-gray-900">@order.ItemCount</td>
                                <td class="px-5 py-3.5 text-right font-bold text-gray-900">@order.TotalAmount.ToString("#,##0.##")</td>
                                <td class="px-5 py-3.5"><span data-realtime-payment-status class="@PaymentBadge(order.PaymentStatus)">@order.PaymentStatus</span></td>
                                <td class="px-5 py-3.5"><span data-realtime-order-status class="@OrderBadge(order.OrderStatus)">@order.OrderStatus</span></td>
                                <td class="px-5 py-3.5 text-gray-400 text-xs">@order.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="px-5 py-3.5">
                                    <a asp-area="@Model.AreaName" asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id" class="px-2.5 py-1 bg-orange-50 text-orange-600 text-xs font-semibold rounded-lg hover:bg-orange-100">View</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
