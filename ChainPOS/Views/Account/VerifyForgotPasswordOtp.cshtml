@model ChainPOS.ViewModels.Auth.ResetPasswordWithOtpViewModel

@{
    Layout = null;
    ViewData["Title"] = "Xác thực OTP";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ChainPOS</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        * { box-sizing: border-box; }
        body { font-family: 'Inter', sans-serif; }
        .input-validation-error {
            border-color: #fb923c !important;
            background: #fff7ed !important;
        }
        .validation-summary-valid {
            display: none;
        }
    </style>
</head>
<body class="min-h-screen font-['Inter'] flex bg-white">
    <div class="hidden lg:flex lg:w-[55%] relative flex-col justify-between p-12 overflow-hidden"
         style="background: linear-gradient(135deg, #f97316 0%, #fb923c 40%, #fbbf24 100%);">
        <div class="absolute -top-24 -right-24 w-96 h-96 rounded-full bg-white opacity-10"></div>
        <div class="absolute -bottom-32 -left-20 w-[28rem] h-[28rem] rounded-full bg-white opacity-10"></div>

        <div class="flex items-center gap-3 relative z-10">
            <div class="w-12 h-12 bg-white rounded-2xl flex items-center justify-center shadow-xl">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-orange-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h18v4H3V3zm2 6h14v12H5V9zm3 3h8m-8 4h5" />
                </svg>
            </div>
            <div>
                <h1 class="text-white font-bold text-2xl tracking-tight">ChainPOS</h1>
                <p class="text-orange-100 text-sm font-medium">Store Management + POS</p>
            </div>
        </div>

        <div class="relative z-10 max-w-lg">
            <div class="inline-flex items-center gap-2 bg-white bg-opacity-20 px-3 py-1.5 rounded-full mb-6">
                <span class="w-2 h-2 rounded-full bg-white"></span>
                <span class="text-white text-xs font-semibold">Secure OTP Verification</span>
            </div>
            <h2 class="text-white text-5xl font-bold leading-tight mb-5">
                Nhập OTP<br>và đặt lại<br><span class="text-amber-200">mật khẩu.</span>
            </h2>
            <p class="text-orange-100 text-lg">
                OTP chỉ có hiệu lực trong thời gian ngắn. Sau khi đổi mật khẩu thành công, mã sẽ tự bị hủy.
            </p>
        </div>

        <p class="text-orange-100 text-xs relative z-10">© 2026 ChainPOS · SaaS Retail Platform</p>
    </div>

    <div class="w-full lg:w-[45%] flex items-center justify-center p-6 sm:p-8 bg-white">
        <div class="w-full max-w-[420px]">
            <div class="flex lg:hidden items-center gap-3 mb-8">
                <div class="w-10 h-10 bg-gradient-to-br from-orange-500 to-amber-400 rounded-xl flex items-center justify-center shadow-md">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h18v4H3V3zm2 6h14v12H5V9zm3 3h8m-8 4h5" />
                    </svg>
                </div>
                <div>
                    <h1 class="font-bold text-gray-900 text-xl">ChainPOS</h1>
                    <p class="text-xs text-orange-400">Store Management + POS</p>
                </div>
            </div>

            <h2 class="text-3xl font-bold text-gray-900 mb-1">Xác thực OTP</h2>
            <p class="text-gray-500 text-sm mb-7">Nhập OTP trong email và mật khẩu mới cho tài khoản Owner</p>

            @if (TempData["SuccessMessage"] is string successMessage)
            {
                <div class="mb-4 rounded-xl border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-700">@successMessage</div>
            }
            @if (TempData["ErrorMessage"] is string errorMessage)
            {
                <div class="mb-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">@errorMessage</div>
            }

            <form asp-action="VerifyForgotPasswordOtp" asp-controller="Account" method="post" novalidate>
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="mb-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"></div>

                <div class="mb-4">
                    <label asp-for="Email" class="block text-sm font-medium text-gray-700 mb-1.5"></label>
                    <input asp-for="Email"
                           autocomplete="email"
                           class="w-full px-4 py-3 border border-gray-200 rounded-xl text-sm text-gray-800 focus:outline-none focus:ring-2 focus:ring-orange-400 focus:border-transparent transition-all bg-gray-50 focus:bg-white" />
                    <span asp-validation-for="Email" class="mt-1.5 block text-xs text-red-600"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Otp" class="block text-sm font-medium text-gray-700 mb-1.5"></label>
                    <input asp-for="Otp"
                           inputmode="numeric"
                           autocomplete="one-time-code"
                           maxlength="6"
                           placeholder="123456"
                           class="w-full px-4 py-3 border border-gray-200 rounded-xl text-center text-xl tracking-[0.45em] font-bold text-gray-900 focus:outline-none focus:ring-2 focus:ring-orange-400 focus:border-transparent transition-all bg-gray-50 focus:bg-white" />
                    <span asp-validation-for="Otp" class="mt-1.5 block text-xs text-red-600"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Password" class="block text-sm font-medium text-gray-700 mb-1.5"></label>
                    <input asp-for="Password"
                           autocomplete="new-password"
                           class="w-full px-4 py-3 border border-gray-200 rounded-xl text-sm text-gray-800 focus:outline-none focus:ring-2 focus:ring-orange-400 focus:border-transparent transition-all bg-gray-50 focus:bg-white" />
                    <span asp-validation-for="Password" class="mt-1.5 block text-xs text-red-600"></span>
                </div>

                <div class="mb-6">
                    <label asp-for="ConfirmPassword" class="block text-sm font-medium text-gray-700 mb-1.5"></label>
                    <input asp-for="ConfirmPassword"
                           autocomplete="new-password"
                           class="w-full px-4 py-3 border border-gray-200 rounded-xl text-sm text-gray-800 focus:outline-none focus:ring-2 focus:ring-orange-400 focus:border-transparent transition-all bg-gray-50 focus:bg-white" />
                    <span asp-validation-for="ConfirmPassword" class="mt-1.5 block text-xs text-red-600"></span>
                </div>

                <button type="submit"
                        class="w-full py-3.5 bg-gradient-to-r from-orange-500 to-amber-500 text-white font-semibold rounded-xl hover:from-orange-600 hover:to-amber-600 transition-all shadow-md hover:shadow-orange-200 hover:shadow-lg transform hover:-translate-y-0.5">
                    Đổi mật khẩu
                </button>
            </form>

            <div class="flex items-center justify-between mt-6 text-sm">
                <a asp-action="ForgotPassword" asp-controller="Account" class="text-orange-500 hover:text-orange-600 font-semibold">Gửi lại OTP</a>
                <a asp-action="Login" asp-controller="Account" class="text-gray-500 hover:text-orange-600 font-medium">Quay lại đăng nhập</a>
            </div>

            <p class="text-center text-xs text-gray-400 mt-8">© 2026 ChainPOS · SaaS Retail Platform</p>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
