@model ChainPOS.ViewModels.Auth.LoginViewModel

@{
    Layout = null;
    ViewData["Title"] = "Đăng nhập";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ChainPOS</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        * { box-sizing: border-box; }
        body { font-family: 'Inter', sans-serif; }
        .pulse-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #ffffff;
            animation: pulseDot 2s infinite;
        }
        @@keyframes pulseDot {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: .55; transform: scale(1.35); }
        }
        .input-validation-error {
            border-color: #fb923c !important;
            background: #fff7ed !important;
        }
        .validation-summary-valid {
            display: none;
        }
    </style>
</head>
<body class="min-h-screen font-['Inter'] flex bg-white">
    <div class="hidden lg:flex lg:w-[55%] relative flex-col justify-between p-12 overflow-hidden"
         style="background: linear-gradient(135deg, #f97316 0%, #fb923c 40%, #fbbf24 100%);">
        <div class="absolute -top-24 -right-24 w-96 h-96 rounded-full bg-white opacity-10"></div>
        <div class="absolute top-1/3 -right-16 w-64 h-64 rounded-full bg-amber-300 opacity-20"></div>
        <div class="absolute -bottom-32 -left-20 w-[28rem] h-[28rem] rounded-full bg-white opacity-10"></div>
        <div class="absolute bottom-20 right-20 w-32 h-32 rounded-full bg-orange-300 opacity-30"></div>

        <div class="flex items-center gap-3 relative z-10">
            <div class="w-12 h-12 bg-white rounded-2xl flex items-center justify-center shadow-xl">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-orange-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h18v4H3V3zm2 6h14v12H5V9zm3 3h8m-8 4h5" />
                </svg>
            </div>
            <div>
                <h1 class="text-white font-bold text-2xl tracking-tight">ChainPOS</h1>
                <p class="text-orange-100 text-sm font-medium">Store Management + POS</p>
            </div>
        </div>

        <div class="relative z-10">
            <div class="inline-flex items-center gap-2 bg-white bg-opacity-20 px-3 py-1.5 rounded-full mb-6">
                <span class="pulse-dot"></span>
                <span class="text-white text-xs font-semibold">SaaS POS Platform</span>
            </div>
            <h2 class="text-white text-5xl font-bold leading-tight mb-5">
                Quản lý<br>chuỗi cửa hàng<br><span class="text-amber-200">tập trung.</span>
            </h2>
            <p class="text-orange-100 text-lg mb-10 max-w-md">
                Một hệ thống cho bán hàng POS, tồn kho, nhân sự theo cửa hàng, subscription và báo cáo.
            </p>

            <div class="grid grid-cols-2 gap-3 max-w-md">
                <div class="bg-white bg-opacity-15 backdrop-blur-sm border border-white border-opacity-20 rounded-2xl p-4">
                    <div class="w-9 h-9 bg-white bg-opacity-25 rounded-xl flex items-center justify-center mb-3">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7h18M5 7v12h14V7M8 11h8" />
                        </svg>
                    </div>
                    <p class="text-white font-semibold text-sm">POS bán hàng</p>
                    <p class="text-orange-100 text-xs mt-0.5">Đơn hàng, thanh toán, hóa đơn</p>
                </div>
                <div class="bg-white bg-opacity-15 backdrop-blur-sm border border-white border-opacity-20 rounded-2xl p-4">
                    <div class="w-9 h-9 bg-white bg-opacity-25 rounded-xl flex items-center justify-center mb-3">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4 8 4 8-4zM4 7v10l8 4 8-4V7" />
                        </svg>
                    </div>
                    <p class="text-white font-semibold text-sm">Quản lý kho</p>
                    <p class="text-orange-100 text-xs mt-0.5">Nhập, xuất, điều chỉnh tồn</p>
                </div>
                <div class="bg-white bg-opacity-15 backdrop-blur-sm border border-white border-opacity-20 rounded-2xl p-4">
                    <div class="w-9 h-9 bg-white bg-opacity-25 rounded-xl flex items-center justify-center mb-3">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
                        </svg>
                    </div>
                    <p class="text-white font-semibold text-sm">Tenant & Staff</p>
                    <p class="text-orange-100 text-xs mt-0.5">Role, cửa hàng, phân quyền</p>
                </div>
                <div class="bg-white bg-opacity-15 backdrop-blur-sm border border-white border-opacity-20 rounded-2xl p-4">
                    <div class="w-9 h-9 bg-white bg-opacity-25 rounded-xl flex items-center justify-center mb-3">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6h6zm0 0h6V7a2 2 0 012-2h2v14h-4" />
                        </svg>
                    </div>
                    <p class="text-white font-semibold text-sm">Báo cáo</p>
                    <p class="text-orange-100 text-xs mt-0.5">Doanh thu, kho, nhân viên</p>
                </div>
            </div>
        </div>

        <div class="flex items-center justify-between relative z-10">
            <p class="text-orange-100 text-xs">© 2026 ChainPOS · SaaS Retail Platform</p>
            <div class="flex gap-1">
                <div class="w-2 h-2 rounded-full bg-white opacity-60"></div>
                <div class="w-2 h-2 rounded-full bg-white opacity-30"></div>
                <div class="w-2 h-2 rounded-full bg-white opacity-30"></div>
            </div>
        </div>
    </div>

    <div class="w-full lg:w-[45%] flex items-center justify-center p-6 sm:p-8 bg-white">
        <div class="w-full max-w-[420px]">
            <div class="flex lg:hidden items-center gap-3 mb-8">
                <div class="w-10 h-10 bg-gradient-to-br from-orange-500 to-amber-400 rounded-xl flex items-center justify-center shadow-md">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h18v4H3V3zm2 6h14v12H5V9zm3 3h8m-8 4h5" />
                    </svg>
                </div>
                <div>
                    <h1 class="font-bold text-gray-900 text-xl">ChainPOS</h1>
                    <p class="text-xs text-orange-400">Store Management + POS</p>
                </div>
            </div>

            <h2 class="text-3xl font-bold text-gray-900 mb-1">Đăng nhập</h2>
            <p class="text-gray-500 text-sm mb-7">Truy cập dashboard theo vai trò của bạn</p>

            <div class="mb-6">
                <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Vai trò hệ thống</p>
                <div class="flex flex-wrap gap-2">
                    <button type="button" data-login-email="admin@chainpos.local" class="role-pill px-3 py-1.5 rounded-full text-xs font-semibold border transition-all bg-orange-500 text-white border-orange-500">Admin</button>
                    <button type="button" data-login-email="owner@demo.local" class="role-pill px-3 py-1.5 rounded-full text-xs font-semibold border transition-all bg-gray-50 text-gray-600 border-gray-200 hover:border-orange-300">Owner</button>
                    <button type="button" data-login-email="staff01@demo.local" class="role-pill px-3 py-1.5 rounded-full text-xs font-semibold border transition-all bg-gray-50 text-gray-600 border-gray-200 hover:border-orange-300">Staff</button>
                </div>
            </div>

            <form asp-action="Login" asp-controller="Account" method="post" novalidate>
                @Html.AntiForgeryToken()
                <input asp-for="ReturnUrl" type="hidden" />

                <div asp-validation-summary="ModelOnly" class="mb-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"></div>

                <div class="mb-4">
                    <label asp-for="UserNameOrEmail" class="block text-sm font-medium text-gray-700 mb-1.5"></label>
                    <div class="relative">
                        <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207" />
                            </svg>
                        </span>
                        <input asp-for="UserNameOrEmail"
                               autocomplete="username"
                               class="w-full pl-10 pr-4 py-3 border border-gray-200 rounded-xl text-sm text-gray-800 focus:outline-none focus:ring-2 focus:ring-orange-400 focus:border-transparent transition-all bg-gray-50 focus:bg-white" />
                    </div>
                    <span asp-validation-for="UserNameOrEmail" class="mt-1.5 block text-xs text-red-600"></span>
                </div>

                <div class="mb-5">
                    <div class="flex items-center justify-between mb-1.5">
                        <label asp-for="Password" class="text-sm font-medium text-gray-700"></label>
                        <a href="#" class="text-xs text-orange-500 hover:text-orange-600 font-medium">Quên mật khẩu?</a>
                    </div>
                    <div class="relative">
                        <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                            </svg>
                        </span>
                        <input asp-for="Password"
                               autocomplete="current-password"
                               placeholder="Nhập mật khẩu"
                               class="w-full pl-10 pr-12 py-3 border border-gray-200 rounded-xl text-sm text-gray-800 focus:outline-none focus:ring-2 focus:ring-orange-400 focus:border-transparent transition-all bg-gray-50 focus:bg-white" />
                        <button type="button" id="togglePassword" class="absolute right-3.5 top-1/2 -translate-y-1/2 text-gray-400 hover:text-orange-500 transition-colors" aria-label="Ẩn/hiện mật khẩu">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                            </svg>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="mt-1.5 block text-xs text-red-600"></span>
                </div>

                <div class="flex items-center gap-2 mb-6">
                    <input asp-for="RememberMe" class="w-4 h-4 accent-orange-500 rounded" />
                    <label asp-for="RememberMe" class="text-sm text-gray-600 cursor-pointer"></label>
                </div>

                <button type="submit"
                        class="w-full py-3.5 bg-gradient-to-r from-orange-500 to-amber-500 text-white font-semibold rounded-xl hover:from-orange-600 hover:to-amber-600 transition-all shadow-md hover:shadow-orange-200 hover:shadow-lg transform hover:-translate-y-0.5 flex items-center justify-center gap-2">
                    <span>Đăng nhập dashboard</span>
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                    </svg>
                </button>
            </form>

            <div class="flex items-center gap-3 my-5">
                <div class="flex-1 h-px bg-gray-100"></div>
                <span class="text-xs text-gray-400 font-medium">Ghi chú</span>
                <div class="flex-1 h-px bg-gray-100"></div>
            </div>

            <div class="bg-amber-50 border border-amber-200 rounded-xl p-4">
                <div class="flex items-start gap-2.5">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-600 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <div>
                        <p class="text-xs font-semibold text-amber-800 mb-1">Tài khoản demo</p>
                        <p class="text-xs text-amber-700">Admin: admin@chainpos.local / Admin@123</p>
                        <p class="text-xs text-amber-700">Owner: owner@demo.local / Owner@123</p>
                        <p class="text-xs text-amber-700">Staff: staff01@demo.local / Staff@123</p>
                    </div>
                </div>
            </div>

            <p class="text-center text-xs text-gray-400 mt-6">© 2026 ChainPOS · SaaS Retail Platform</p>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script>
        document.querySelectorAll('.role-pill').forEach((button) => {
            button.addEventListener('click', () => {
                document.getElementById('UserNameOrEmail').value = button.dataset.loginEmail || '';
                document.querySelectorAll('.role-pill').forEach((item) => {
                    const isActive = item === button;
                    item.className = `role-pill px-3 py-1.5 rounded-full text-xs font-semibold border transition-all ${isActive ? 'bg-orange-500 text-white border-orange-500' : 'bg-gray-50 text-gray-600 border-gray-200 hover:border-orange-300'}`;
                });
            });
        });

        document.getElementById('togglePassword').addEventListener('click', () => {
            const password = document.getElementById('Password');
            password.type = password.type === 'password' ? 'text' : 'password';
        });
    </script>
</body>
</html>
